<view wx:if="{{visible}}" class="success-mask" catchtouchmove="preventMove">
  <view class="success-card">
    <view class="success-ring"><view class="success-check">✓</view></view>
    <view class="success-title">礼品领取完成</view>
    <view class="success-desc">门店已完成本次礼品核销，感谢您的到店。</view>
    <view class="success-note">兑换记录将保留在「我的礼品」中，便于随时查看。</view>
    <view class="success-button" bindtap="close">我知道了</view>
  </view>
</view>
