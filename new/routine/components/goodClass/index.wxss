.goodsList { padding: 0 2rpx; }
.goodsList .item { width: 100%; min-height: 176rpx; margin-bottom: 18rpx; padding: 16rpx; box-sizing: border-box; border: 1rpx solid #F3ECE4; border-radius: 20rpx; background: #FFFFFF; box-shadow: 0 8rpx 22rpx rgba(112, 77, 42, 0.055); }
.goodsList .item .pictrue { position: relative; width: 144rpx; height: 144rpx; flex: 0 0 144rpx; border-radius: 15rpx; overflow: hidden; background: #F8F6F3; }
.goodsList .item .pictrue image { width: 100%; height: 100%; border-radius: 15rpx; object-fit: contain; }
.goodsList .item .pictxt { width: auto; min-width: 0; flex: 1; margin-left: 18rpx; align-self: stretch; display: flex; flex-direction: column; justify-content: space-between; }
.goodsList .item .pictxt .text { min-height: 64rpx; color: #302821; font-size: 26rpx; font-weight: 700; line-height: 34rpx; }
.goodsList .item .pictxt .bottom { margin-top: 0; min-height: 50rpx; }
.goodsList .item .pictxt .bottom .money { color: #EF5A2B; font-size: 37rpx; font-weight: 800; }
.goodsList .item .pictxt .bottom .money .sign { font-size: 23rpx; }
.goodsList .item .pictxt .bottom .money .y_money { margin-left: 10rpx; color: #B6AAA0; font-size: 19rpx; font-weight: 400; }
.goodsList .item .pictxt .bottom .money .vip { margin-left: 9rpx; color: #A47842; font-size: 20rpx; font-weight: 500; }
.goodsList .item .pictxt .bottom .money .vip image { width: 36rpx; height: 18rpx; margin-right: 5rpx; }
.goodsList .item .pictxt .bottom .cart { height: 50rpx; }
.goodsList .item .pictxt .bottom .cart .pictrue { width: 46rpx; height: 46rpx; flex: 0 0 46rpx; color: #FF6A2A; font-size: 42rpx; line-height: 46rpx; text-align: center; background: transparent; }
.goodsList .item .pictxt .bottom .cart .num { width: 54rpx; color: #3E342C; font-size: 26rpx; font-weight: 700; text-align: center; }
.goodsList .item .pictxt .bottom .icon-gouwuche6 { width: 50rpx; height: 50rpx; border-radius: 50%; color: #FFFFFF; background: #FF6A2A; font-size: 29rpx; box-shadow: 0 7rpx 13rpx rgba(255, 106, 42, 0.2); }
.goodsList .item .pictxt .bottom .bnt { position: relative; min-width: 72rpx; height: 50rpx; padding: 0 15rpx; border-radius: 27rpx; color: #FFFFFF; background: #FF6A2A; font-size: 22rpx; line-height: 50rpx; text-align: center; }
.goodsList .item .pictxt .bottom .bnt.end { color: #A9A19A; background: #ECE8E3; }
.goodsList .item .pictxt .bottom .bnt .num { position: absolute; top: -11rpx; right: -12rpx; min-width: 28rpx; height: 28rpx; padding: 0 6rpx; border: 2rpx solid #FFFFFF; border-radius: 18rpx; box-sizing: border-box; color: #FFFFFF; background: #FF6A2A; font-size: 17rpx; line-height: 24rpx; }
