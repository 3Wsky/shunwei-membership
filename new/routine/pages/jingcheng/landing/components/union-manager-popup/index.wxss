.manager-mask{position:fixed;inset:0;z-index:80;display:flex;align-items:flex-end;padding:26rpx;background:rgba(48,0,4,.72);box-sizing:border-box}.manager-card{position:relative;width:100%;padding:56rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));border:4rpx solid #f4c665;border-radius:30rpx;background:linear-gradient(150deg,#fffdf7,#fff0d4);box-sizing:border-box;box-shadow:0 24rpx 70rpx rgba(34,0,2,.42);animation:managerUp .32s cubic-bezier(.2,.8,.2,1)}.manager-ribbon{position:absolute;left:50%;top:-31rpx;width:350rpx;height:62rpx;margin-left:-175rpx;border-radius:999rpx;background:linear-gradient(180deg,#f6bf5d,#de8419);color:#791119;font-size:25rpx;font-weight:900;line-height:62rpx;text-align:center}.manager-close{position:absolute;right:22rpx;top:20rpx;width:52rpx;height:52rpx;border:2rpx solid #e6bd75;border-radius:50%;background:#fff8e8;color:#8f231b;font-size:42rpx;line-height:45rpx;text-align:center}.manager-head{display:flex;align-items:center;padding-right:38rpx}.manager-avatar{width:116rpx;height:116rpx;flex:0 0 116rpx;border:5rpx solid #f0bd67;border-radius:50%;background:#f5e4cc}.manager-avatar.fallback{display:flex;align-items:center;justify-content:center;color:#b71520;font-size:42rpx;font-weight:900}.manager-copy{flex:1;min-width:0;margin-left:18rpx}.manager-name-row{display:flex;align-items:center;gap:12rpx}.manager-name{max-width:220rpx;color:#3a1e1a;font-size:34rpx;font-weight:900;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}.manager-role{padding:5rpx 9rpx;border:1rpx solid #e39c42;border-radius:6rpx;color:#b45e0b;font-size:18rpx}.manager-store{margin-top:5rpx;color:#78584c;font-size:21rpx}.manager-phone{margin-top:9rpx;color:#4b2a24;font-size:23rpx;font-weight:700}.manager-address{margin-top:22rpx;padding:17rpx 18rpx;border-radius:12rpx;background:#fff8e9;color:#765247;font-size:21rpx}.manager-address text{float:right;color:#c90d1b;font-size:31rpx}.manager-qrcode{display:block;width:230rpx;height:230rpx;margin:20rpx auto 0;border:2rpx solid #edd4a7;border-radius:14rpx;background:#fff}.qrcode-note{text-align:center;color:#9d7a64;font-size:19rpx}.manager-call{height:82rpx;margin:22rpx 0 0;border:3rpx solid #ffcf69;border-radius:999rpx;background:linear-gradient(180deg,#e93630,#b90813);color:#fff7d5;font-size:30rpx;font-weight:900;line-height:76rpx;box-shadow:0 10rpx 20rpx rgba(122,4,10,.22)}.manager-call::after{border:0}.manager-call text{float:right;margin-right:26rpx;font-size:42rpx}@keyframes managerUp{from{transform:translateY(90rpx);opacity:0}to{transform:translateY(0);opacity:1}}
