<view class="category-block {{active ? 'category-entered' : ''}}">
  <view class="category-title-wrap">
    <view class="category-ornament">· ·</view>
    <view class="category-title">{{block.name}}</view>
    <view class="category-ornament">· ·</view>
  </view>
  <view class="category-subtitle">{{block.subtitle}}</view>

  <swiper wx:if="{{block.productPages.length}}" class="product-swiper" indicator-dots="{{block.productPages.length > 1}}" indicator-color="rgba(255,239,196,.45)" indicator-active-color="#FFC447" autoplay="{{block.productPages.length > 1}}" circular="{{block.productPages.length > 1}}" interval="4200" duration="500">
    <swiper-item wx:for="{{block.productPages}}" wx:for-item="page" wx:key="pageKey">
      <view class="product-grid">
        <view wx:for="{{page.items}}" wx:for-item="item" wx:key="id" class="product-card product-card-{{index % 4}}" data-id="{{item.id}}" bindtap="selectProduct" hover-class="card-pressed">
          <view wx:if="{{item.tag}}" class="product-tag">{{item.tag}}</view>
          <image wx:if="{{item.image}}" class="product-image" src="{{item.image}}" mode="aspectFit"></image>
          <view wx:else class="product-image product-placeholder">数码好物</view>
          <view class="product-name">{{item.name}}</view>
          <view class="product-price">
            <view class="official-price"><text>官网价</text><text>{{item.officialPriceText}}</text></view>
            <view class="subsidy-price"><text>{{item.subsidyLabel}}</text><strong>{{item.subsidyPriceText}}</strong></view>
          </view>
          <view class="product-coupon">额外送 <text>{{item.couponText}}</text> 元现金券</view>
          <view class="product-points">+ {{item.pointsText}} 积分</view>
        </view>
      </view>
    </swiper-item>
  </swiper>
  <view wx:else class="category-empty">更多{{block.name}}产品正在整理中</view>
</view>
