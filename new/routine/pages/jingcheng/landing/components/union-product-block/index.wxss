.category-block{position:relative;margin-top:28rpx;padding:38rpx 18rpx 20rpx;border:2rpx solid rgba(255,215,121,.65);border-radius:22rpx;background:linear-gradient(180deg,rgba(255,94,65,.2),rgba(123,2,12,.28));box-shadow:inset 0 0 36rpx rgba(255,69,44,.16),0 12rpx 28rpx rgba(71,0,4,.2)}.category-title-wrap{position:absolute;left:50%;top:-29rpx;min-width:260rpx;height:58rpx;padding:0 28rpx;display:flex;align-items:center;justify-content:center;gap:19rpx;transform:translateX(-50%);border:2rpx solid #f8c35f;border-radius:999rpx;background:linear-gradient(180deg,#d7282f,#9a0711);box-sizing:border-box;box-shadow:0 8rpx 18rpx rgba(56,0,4,.25)}.category-title{color:#fff6d8;font-size:31rpx;font-weight:900;letter-spacing:6rpx}.category-ornament{color:#ffc447;font-size:20rpx;white-space:nowrap}.category-subtitle{text-align:center;color:#f9c9b5;font-size:20rpx}.product-grid{margin-top:18rpx;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14rpx}.product-card{position:relative;overflow:hidden;min-width:0;padding:13rpx 13rpx 15rpx;border:2rpx solid #f6c46b;border-radius:16rpx;background:linear-gradient(180deg,#fffdf8,#fff2dd);box-sizing:border-box;box-shadow:0 8rpx 18rpx rgba(62,0,4,.2)}.product-tag{position:absolute;z-index:2;left:10rpx;top:10rpx;padding:4rpx 10rpx;border-radius:999rpx;background:#c90d1b;color:#fff6d5;font-size:17rpx;font-weight:800}.product-image{display:block;width:100%;height:205rpx;border-radius:11rpx;background:#fff}.product-placeholder{display:flex;align-items:center;justify-content:center;color:#b68566;font-size:22rpx}.product-name{margin-top:10rpx;height:63rpx;color:#35191a;font-size:23rpx;line-height:31rpx;font-weight:800;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}.product-price{margin-top:3rpx;color:#76534a;font-size:21rpx}.product-coupon{margin-top:8rpx;color:#d21925;font-size:20rpx;font-weight:800}.product-coupon text{font-size:31rpx;font-weight:900}.product-points{margin-top:6rpx;padding:6rpx 8rpx;border-radius:999rpx;background:#ffe0a1;color:#b55c08;font-size:20rpx;font-weight:900;text-align:center;white-space:nowrap}.category-empty{margin-top:20rpx;padding:50rpx 20rpx;border-radius:14rpx;background:rgba(255,248,237,.1);color:#f4cbbb;font-size:22rpx;text-align:center}.card-pressed{opacity:.9;transform:scale(.985)}
