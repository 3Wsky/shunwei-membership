.cta-wrap{width:100%;text-align:center}.cta-button{position:relative;overflow:hidden;height:96rpx;margin:0;border:4rpx solid #fff0b6;border-radius:999rpx;background:linear-gradient(180deg,#fff1b9 0%,#ffc447 58%,#eca620 100%);color:#9b1018;font-size:38rpx;font-weight:900;line-height:88rpx;box-shadow:0 12rpx 0 #94131b,0 20rpx 38rpx rgba(74,4,8,.28);letter-spacing:1rpx}.cta-button::after{border:0}.cta-arrow{position:absolute;right:38rpx;top:50%;width:52rpx;height:52rpx;margin-top:-26rpx;border-radius:50%;background:#c91824;color:#fff;font-size:45rpx;line-height:47rpx;text-align:center}.cta-shine{position:absolute;top:-30rpx;left:-150rpx;width:88rpx;height:160rpx;background:rgba(255,255,255,.42);transform:rotate(24deg);animation:ctaShine 2.7s linear infinite}.cta-note{margin-top:22rpx;color:#ffe7b6;font-size:22rpx;line-height:30rpx}.compact .cta-button{height:76rpx;border-width:2rpx;font-size:29rpx;line-height:70rpx;box-shadow:0 8rpx 0 #94131b,0 12rpx 24rpx rgba(74,4,8,.22)}.compact .cta-arrow{right:24rpx;width:42rpx;height:42rpx;margin-top:-21rpx;font-size:36rpx;line-height:38rpx}.compact .cta-note{display:none}.cta-pressed{transform:translateY(5rpx);box-shadow:0 5rpx 0 #94131b!important}@keyframes ctaShine{0%{left:-150rpx}42%,100%{left:780rpx}}
