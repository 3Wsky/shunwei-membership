.page { min-height: 100vh; background: #f6f2eb; color: #211a16; padding-bottom: env(safe-area-inset-bottom); }
.hero { padding: 42rpx 32rpx 34rpx; color: #fff; background: linear-gradient(135deg, rgba(142,31,25,.96), rgba(230,115,35,.92) 48%, rgba(242,185,83,.96)), #c8442c; }
.hero-topline { display: inline-flex; padding: 8rpx 18rpx; border-radius: 999rpx; background: rgba(255,255,255,.18); color: rgba(255,255,255,.92); font-size: 22rpx; }
.hero-title { margin-top: 22rpx; font-size: 54rpx; font-weight: 900; line-height: 1.12; }
.hero-subtitle { margin-top: 14rpx; max-width: 660rpx; font-size: 28rpx; line-height: 1.45; color: rgba(255,255,255,.92); }
.ticket-card { margin-top: 30rpx; min-height: 190rpx; border-radius: 20rpx; background: #fff9ef; color: #8f261b; display: flex; overflow: hidden; box-shadow: 0 16rpx 44rpx rgba(92,25,15,.22); }
.ticket-main { flex: 1; padding: 26rpx 28rpx; display: flex; flex-direction: column; justify-content: center; }
.ticket-label { font-size: 24rpx; color: #936444; }
.ticket-value { margin-top: 8rpx; font-size: 42rpx; font-weight: 900; line-height: 1.16; }
.ticket-extra { margin-top: 6rpx; font-size: 30rpx; font-weight: 800; color: #c27411; }
.ticket-side { width: 132rpx; padding: 18rpx; background: #2b2638; color: #ffd98a; font-size: 24rpx; font-weight: 700; writing-mode: vertical-rl; display: flex; align-items: center; justify-content: center; letter-spacing: 2rpx; }
.benefit-row { margin-top: 24rpx; display: flex; flex-wrap: wrap; gap: 14rpx; }
.benefit-pill { padding: 10rpx 18rpx; border-radius: 999rpx; background: rgba(255,255,255,.18); border: 1rpx solid rgba(255,255,255,.3); font-size: 23rpx; }
.hero-actions { margin-top: 28rpx; display: flex; gap: 18rpx; }
.primary-btn, .ghost-btn { height: 78rpx; border-radius: 999rpx; padding: 0 24rpx; margin: 0; font-size: 25rpx; font-weight: 800; display: flex; align-items: center; justify-content: center; }
.primary-btn { flex: 1.2; color: #8b2b12; background: #fff4d8; }
.ghost-btn { flex: 1; color: #fff; background: rgba(255,255,255,.16); border: 1rpx solid rgba(255,255,255,.42); }
.hero-note { margin-top: 20rpx; font-size: 22rpx; color: rgba(255,255,255,.82); line-height: 1.45; }
.anchor-bar { position: sticky; top: 0; z-index: 20; display: grid; grid-template-columns: repeat(4,1fr); gap: 10rpx; padding: 18rpx 24rpx; background: rgba(246,242,235,.96); backdrop-filter: blur(10px); }
.anchor-item { height: 58rpx; border-radius: 999rpx; background: #fff; color: #705044; font-size: 23rpx; font-weight: 700; display: flex; align-items: center; justify-content: center; box-shadow: 0 4rpx 16rpx rgba(74,44,28,.05); }
.section { margin: 22rpx 24rpx 0; padding: 28rpx 22rpx; border-radius: 16rpx; background: #fff; box-shadow: 0 6rpx 24rpx rgba(59,40,28,.06); }
.section-head { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; }
.section-kicker { font-size: 19rpx; font-weight: 800; color: #b87b24; }
.section-title { margin-top: 4rpx; font-size: 34rpx; line-height: 1.22; font-weight: 900; color: #211a16; }
.section-tag, .section-link { flex-shrink: 0; padding: 8rpx 16rpx; border-radius: 999rpx; background: #fff1dc; color: #a45d14; font-size: 22rpx; font-weight: 700; }
.section-link { color: #1f4d68; background: #e7f3f6; }
.section-desc { margin-top: 14rpx; color: #6f625c; font-size: 24rpx; line-height: 1.5; }
.rule-grid { margin-top: 22rpx; display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; }
.rule-card { padding: 20rpx; border-radius: 14rpx; background: #fff8ed; border: 1rpx solid #f0ddbd; }
.rule-range { font-size: 22rpx; color: #7a6252; }
.rule-main { margin-top: 8rpx; font-size: 31rpx; font-weight: 900; color: #bd3c22; }
.rule-sub { margin-top: 6rpx; font-size: 22rpx; color: #846958; }
.notice-card { margin-top: 18rpx; padding: 20rpx; border-radius: 14rpx; background: #f5f8f4; color: #4f6250; font-size: 23rpx; line-height: 1.55; }
.tab-scroll { margin-top: 22rpx; white-space: nowrap; }
.tab-row { display: flex; gap: 14rpx; }
.tab-pill { flex-shrink: 0; padding: 14rpx 24rpx; border-radius: 999rpx; background: #f1ede7; color: #65564f; font-size: 24rpx; font-weight: 700; }
.tab-pill.active { background: #2b2638; color: #ffd98a; }
.tab-pill.merchant.active { background: #275466; color: #e8f9ff; }
.product-module-scroll { margin-top: 22rpx; white-space: nowrap; }
.product-module-row { display: flex; gap: 18rpx; }
.product-module { flex-shrink: 0; width: 620rpx; padding: 18rpx; border-radius: 16rpx; background: #fbfaf7; border: 1rpx solid #eee2d2; box-sizing: border-box; vertical-align: top; white-space: normal; }
.module-head { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; padding-bottom: 14rpx; border-bottom: 1rpx solid #eee5da; }
.module-title { font-size: 30rpx; font-weight: 900; color: #211a16; }
.module-count { flex-shrink: 0; padding: 6rpx 14rpx; border-radius: 999rpx; background: #fff1dc; color: #a45d14; font-size: 21rpx; font-weight: 800; }
.module-empty { height: 220rpx; display: flex; align-items: center; justify-content: center; color: #887368; font-size: 24rpx; }
.module-product-card { margin-top: 16rpx; display: flex; gap: 16rpx; padding: 14rpx; border-radius: 14rpx; background: #fff; box-shadow: 0 4rpx 16rpx rgba(59,40,28,.04); }
.module-product-image, .module-image-placeholder { width: 148rpx; height: 148rpx; border-radius: 12rpx; flex-shrink: 0; }
.module-image-placeholder { background: linear-gradient(135deg,#e7eef1,#f6e2cc); color: #6c5d56; font-size: 22rpx; font-weight: 800; display: flex; align-items: center; justify-content: center; }
.module-product-body { flex: 1; min-width: 0; }
.module-product-name { color: #211a16; font-size: 27rpx; font-weight: 900; line-height: 1.32; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.module-product-benefits { margin-top: 8rpx; display: flex; flex-wrap: wrap; gap: 8rpx; color: #bd3c22; font-size: 22rpx; font-weight: 800; }
.module-product-desc { margin-top: 6rpx; color: #746861; font-size: 21rpx; line-height: 1.35; display: -webkit-box; -webkit-line-clamp: 1; -webkit-box-orient: vertical; overflow: hidden; }
.module-card-btn { margin: 10rpx 0 0; width: 190rpx; height: 50rpx; border-radius: 999rpx; background: #8f2b1d; color: #fff; font-size: 21rpx; font-weight: 800; display: flex; align-items: center; justify-content: center; }
.product-list { margin-top: 22rpx; display: flex; flex-direction: column; gap: 18rpx; }
.product-card { display: flex; gap: 18rpx; padding: 16rpx; border-radius: 14rpx; background: #fbfaf7; border: 1rpx solid #eee5da; }
.product-image, .image-placeholder { width: 178rpx; height: 178rpx; border-radius: 12rpx; flex-shrink: 0; }
.image-placeholder { background: linear-gradient(135deg,#e7eef1,#f6e2cc); color: #6c5d56; font-size: 24rpx; font-weight: 800; display: flex; align-items: center; justify-content: center; }
.product-body { flex: 1; min-width: 0; }
.product-name { color: #211a16; font-size: 29rpx; font-weight: 800; line-height: 1.35; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.product-tag { margin-top: 8rpx; display: inline-flex; padding: 5rpx 12rpx; border-radius: 8rpx; background: #eaf4f7; color: #24576a; font-size: 21rpx; }
.product-benefits { margin-top: 10rpx; display: flex; flex-wrap: wrap; gap: 8rpx; color: #bd3c22; font-size: 23rpx; font-weight: 800; }
.product-desc { margin-top: 8rpx; color: #746861; font-size: 22rpx; line-height: 1.35; display: -webkit-box; -webkit-line-clamp: 1; -webkit-box-orient: vertical; overflow: hidden; }
.card-btn, .nav-btn, .small-btn { margin: 14rpx 0 0; height: 54rpx; border-radius: 999rpx; background: #8f2b1d; color: #fff; font-size: 22rpx; font-weight: 800; display: flex; align-items: center; justify-content: center; }
.points-scroll { margin-top: 20rpx; white-space: nowrap; }
.points-row { display: flex; gap: 16rpx; }
.point-card { flex-shrink: 0; width: 202rpx; padding: 14rpx; border-radius: 14rpx; background: #fbfaf7; border: 1rpx solid #eee5da; }
.point-image, .point-placeholder { width: 202rpx; height: 160rpx; border-radius: 12rpx; }
.point-placeholder { background: #e7f3f6; color: #275466; display: flex; align-items: center; justify-content: center; font-size: 23rpx; font-weight: 800; }
.point-title { margin-top: 12rpx; min-height: 64rpx; font-size: 24rpx; font-weight: 800; color: #211a16; line-height: 1.35; white-space: normal; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.point-price { margin-top: 8rpx; font-size: 25rpx; font-weight: 900; color: #b87b24; }
.point-stock { margin-top: 4rpx; font-size: 21rpx; color: #6f625c; }
.merchant-list { margin-top: 22rpx; display: flex; flex-direction: column; gap: 18rpx; }
.merchant-card { display: flex; gap: 18rpx; padding: 16rpx; border-radius: 14rpx; background: #fbfaf7; border: 1rpx solid #eee5da; }
.merchant-cover { width: 172rpx; height: 172rpx; border-radius: 12rpx; flex-shrink: 0; }
.merchant-cover.placeholder { background: #f3ecdc; color: #7d5b2d; font-size: 23rpx; font-weight: 800; display: flex; align-items: center; justify-content: center; }
.merchant-info { flex: 1; min-width: 0; }
.merchant-name { font-size: 28rpx; font-weight: 900; color: #211a16; line-height: 1.35; }
.merchant-meta { margin-top: 8rpx; color: #275466; font-size: 22rpx; font-weight: 700; }
.merchant-address { margin-top: 8rpx; min-height: 34rpx; color: #71645f; font-size: 22rpx; line-height: 1.4; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.nav-btn { width: 160rpx; background: #275466; }
.step-list { margin-top: 20rpx; display: flex; flex-direction: column; gap: 16rpx; }
.step-item { display: flex; align-items: center; gap: 18rpx; padding: 18rpx; border-radius: 14rpx; background: #fbfaf7; }
.step-no { width: 54rpx; height: 54rpx; border-radius: 50%; background: #2b2638; color: #ffd98a; font-size: 24rpx; font-weight: 900; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.step-title { font-size: 26rpx; font-weight: 900; color: #211a16; }
.step-desc { margin-top: 4rpx; font-size: 23rpx; color: #71645f; }
.empty-block, .state-card, .loading-mask { margin-top: 20rpx; padding: 28rpx 18rpx; border-radius: 14rpx; background: #f7f2ea; color: #887368; text-align: center; font-size: 24rpx; }
.state-card { margin: 24rpx; background: #fff; }
.small-btn { width: 180rpx; margin: 18rpx auto 0; }
.loading-mask { margin: 22rpx 24rpx 0; }
.bottom-spacer { height: 142rpx; }
.bottom-bar { position: fixed; left: 0; right: 0; bottom: 0; z-index: 50; padding: 16rpx 20rpx calc(16rpx + env(safe-area-inset-bottom)); display: grid; grid-template-columns: 1fr 1fr 1.25fr; gap: 12rpx; background: rgba(255,255,255,.96); box-shadow: 0 -8rpx 28rpx rgba(41,27,18,.1); }
.bottom-btn { height: 72rpx; margin: 0; border-radius: 999rpx; font-size: 24rpx; font-weight: 900; display: flex; align-items: center; justify-content: center; }
.bottom-btn.secondary { color: #633c2e; background: #f3eadf; }
.bottom-btn.primary { color: #fff; background: linear-gradient(135deg,#b73422,#e88527); }
button::after { border: none; }
