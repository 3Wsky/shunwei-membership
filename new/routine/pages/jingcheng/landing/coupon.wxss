page{background:#8d0610;color:#4a2a22;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif}
.union-page{min-height:100vh;overflow:hidden;background:#8d0610}
.hero-section,.red-section{position:relative;padding:28rpx 24rpx 48rpx;box-sizing:border-box}
.hero-section{overflow:hidden;background:radial-gradient(circle at 50% 16%,#f13b44 0,#c90d1b 36%,#8d0610 78%)}
.hero-section::after,.red-section::after{content:"";position:absolute;z-index:0;left:-130rpx;right:-130rpx;bottom:-80rpx;height:180rpx;border:34rpx solid rgba(255,196,71,.08);border-radius:50%}
.hero-glow{position:absolute;border-radius:50%;background:radial-gradient(circle,rgba(255,215,115,.25),rgba(255,215,115,0) 68%);pointer-events:none}
.glow-one{width:520rpx;height:520rpx;right:-200rpx;top:70rpx}
.glow-two{width:420rpx;height:420rpx;left:-220rpx;top:520rpx}
.float-token{position:absolute;z-index:1;width:58rpx;height:40rpx;border:2rpx solid #f4bd57;border-radius:8rpx;background:linear-gradient(145deg,#fff2bd,#f5aa25);color:#a30e18;font-size:22rpx;font-weight:900;line-height:40rpx;text-align:center;box-shadow:0 8rpx 20rpx rgba(67,0,3,.26);animation:floatToken 4s ease-in-out infinite}
.token-one{left:26rpx;top:260rpx;transform:rotate(-18deg)}
.token-two{right:36rpx;top:350rpx;animation-delay:.8s;transform:rotate(14deg)}
.token-three{right:75rpx;top:760rpx;animation-delay:1.5s;transform:rotate(-10deg)}
.brand-row{position:relative;z-index:2;display:flex;align-items:center;justify-content:space-between;gap:16rpx}
.union-logo{width:300rpx;height:auto}
.brand-badge{padding:14rpx 20rpx;border:2rpx solid rgba(255,220,151,.72);border-radius:999rpx;color:#ffe6aa;background:rgba(113,2,9,.35);font-size:20rpx;font-weight:800;white-space:nowrap}
.hero-heading{position:relative;z-index:2;margin-top:34rpx;text-align:center;color:#fff}
.hero-title-top{font-size:56rpx;line-height:68rpx;font-weight:900;text-shadow:0 7rpx 0 rgba(99,0,5,.45)}
.hero-title-main{margin-top:4rpx;color:#fff7dd;font-size:42rpx;line-height:78rpx;font-weight:900;white-space:nowrap;text-shadow:0 6rpx 0 rgba(99,0,5,.45)}
.hero-title-main text{display:inline-block;margin:0 7rpx;color:#ffe69a;font-size:92rpx;line-height:100rpx;text-shadow:0 7rpx 0 #a50c15,0 0 30rpx rgba(255,211,88,.65)}
.gold-ribbon{position:relative;z-index:2;width:610rpx;min-height:64rpx;margin:16rpx auto 0;padding:12rpx 30rpx;border:2rpx solid #fff0b2;border-radius:18rpx;background:linear-gradient(180deg,#fff1b9,#ffc447);color:#7a1915;font-size:27rpx;line-height:38rpx;font-weight:900;text-align:center;box-sizing:border-box;box-shadow:0 8rpx 20rpx rgba(75,0,4,.25)}
.gold-ribbon.compact{width:570rpx;min-height:58rpx;font-size:24rpx;line-height:32rpx}
.hero-visual{position:relative;z-index:2;height:468rpx;margin:28rpx 0 0;overflow:hidden;border:3rpx solid rgba(255,222,147,.72);border-radius:24rpx;background:#aa0710;box-shadow:0 18rpx 45rpx rgba(62,0,3,.35)}
.hero-visual-image{position:absolute;inset:0;width:100%;height:100%}
.visual-vignette{position:absolute;inset:0;background:linear-gradient(180deg,rgba(92,0,4,.08),transparent 52%,rgba(92,0,4,.3));box-shadow:inset 0 0 54rpx rgba(70,0,3,.3)}
.coupon-copy{position:absolute;left:50%;top:92rpx;width:250rpx;transform:translateX(-50%);color:#a00b15;text-align:center;text-shadow:0 2rpx 0 rgba(255,255,255,.6)}
.coupon-copy-label{font-size:20rpx;font-weight:900}
.coupon-copy-value{margin-top:4rpx;font-size:72rpx;line-height:82rpx;font-weight:900}
.coupon-copy-value text{margin-right:2rpx;font-size:31rpx}
.coupon-copy-note{font-size:16rpx;font-weight:800;white-space:nowrap}
.hero-cta,.section-cta{position:relative;z-index:3;width:620rpx;margin:32rpx auto 0}
.process-panel{position:relative;z-index:2;margin-top:42rpx;padding:28rpx 14rpx 22rpx;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8rpx;border:3rpx solid #f5c569;border-radius:24rpx;background:linear-gradient(180deg,#fff9ed,#ffedcd);box-shadow:0 16rpx 32rpx rgba(71,0,4,.28)}
.process-item{position:relative;min-width:0;text-align:center}
.process-number{position:absolute;left:50%;top:-43rpx;width:52rpx;height:52rpx;margin-left:-26rpx;border-radius:50%;background:#c90d1b;color:#fff5d6;font-size:20rpx;font-weight:900;line-height:52rpx}
.process-icon{width:80rpx;height:80rpx}
.process-title{margin-top:5rpx;color:#5a271e;font-size:21rpx;font-weight:900}
.process-desc{margin-top:6rpx;color:#88655a;font-size:17rpx;line-height:25rpx}
.process-arrow{position:absolute;right:-13rpx;top:43rpx;color:#d6492c;font-size:44rpx;font-weight:300}
.benefit-panel{position:relative;z-index:2;margin-top:62rpx;padding:52rpx 14rpx 20rpx;border:3rpx solid #f6c25b;border-radius:24rpx;background:linear-gradient(145deg,#f5b65d,#d7802e);box-shadow:0 16rpx 34rpx rgba(62,0,3,.28)}
.panel-ribbon,.subsection-ribbon{position:absolute;left:50%;top:-32rpx;min-width:410rpx;height:64rpx;padding:0 32rpx;transform:translateX(-50%);border:2rpx solid #f9c05e;border-radius:14rpx;background:linear-gradient(180deg,#e93834,#ad0712);color:#fff0c1;font-size:28rpx;font-weight:900;line-height:64rpx;text-align:center;box-sizing:border-box;box-shadow:0 8rpx 16rpx rgba(74,0,4,.24)}
.benefit-table-head{display:grid;grid-template-columns:1.15fr 1fr 1fr;padding:0 52rpx 11rpx;color:#6d2a1a;font-size:18rpx;font-weight:800;text-align:center}
.benefit-rule-row{min-height:94rpx;margin-top:10rpx;padding:10rpx 13rpx;display:grid;grid-template-columns:48rpx 1.15fr 1fr 30rpx 1fr;align-items:center;border-radius:16rpx;background:#fffaf0;color:#3f211c;box-sizing:border-box;box-shadow:0 7rpx 15rpx rgba(102,39,6,.13)}
.rule-index{width:43rpx;height:58rpx;border-radius:8rpx;background:#fff0cf;color:#9a510f;font-size:19rpx;font-weight:900;line-height:58rpx;text-align:center}
.rule-range{font-size:20rpx;font-weight:800;text-align:center}
.rule-cash{color:#b90d18;font-size:18rpx;font-weight:800;text-align:center;white-space:nowrap}
.rule-cash text{font-size:35rpx;font-weight:900}
.rule-plus{color:#d57d14;font-size:30rpx;font-weight:900;text-align:center}
.rule-points{color:#bd680a;font-size:24rpx;font-weight:900;text-align:center;white-space:nowrap}
.rule-points text{margin-left:3rpx;font-size:16rpx}
.benefit-valid{margin-top:14rpx;color:#fff6dc;font-size:21rpx;font-weight:800;text-align:center}
.red-section{overflow:hidden;background:radial-gradient(circle at 50% 0,rgba(241,59,68,.58),transparent 38%),linear-gradient(180deg,#aa0813,#7d050d)}
.product-zone{padding-top:64rpx}
.points-zone,.merchant-zone{padding-top:60rpx;border-top:2rpx solid rgba(255,207,112,.4)}
.section-marker{position:relative;z-index:2;width:max-content;margin:0 auto;padding:10rpx 25rpx;border:2rpx solid #e8a93a;border-radius:999rpx;background:rgba(116,0,6,.45);color:#ffd77e;font-size:22rpx;font-weight:900}
.section-title{position:relative;z-index:2;margin-top:20rpx;color:#4a2a22;font-size:46rpx;line-height:58rpx;font-weight:900;text-align:center}
.section-title.light{color:#fff8e7;text-shadow:0 5rpx 0 rgba(85,0,4,.48)}
.section-subtitle{position:relative;z-index:2;margin:10rpx auto 0;max-width:650rpx;color:#8a6c62;font-size:22rpx;line-height:33rpx;text-align:center}
.section-subtitle.light{color:#f5cfc1}
.category-stack{position:relative;z-index:2;margin-top:56rpx}
.stack-note{position:relative;z-index:2;margin-top:26rpx;color:#ffd885;font-size:22rpx;text-align:center}
.fade-section{opacity:.2;transform:translateY(34rpx)}
.fade-section.visible{opacity:1;transform:translateY(0);transition:opacity .65s ease,transform .65s ease}
.live-board{position:relative;z-index:2;height:210rpx;margin-top:34rpx;padding:20rpx 20rpx 20rpx 110rpx;border:7rpx double #ffc75d;border-radius:24rpx;background:linear-gradient(180deg,#5c050a,#310205);box-sizing:border-box;box-shadow:inset 0 0 30rpx rgba(255,115,35,.25),0 14rpx 28rpx rgba(41,0,2,.3)}
.live-label{position:absolute;left:18rpx;top:22rpx;width:70rpx;height:160rpx;border:2rpx solid #d88527;border-radius:12rpx;background:#9f0c14;color:#fff0bd;font-size:23rpx;font-weight:900;line-height:34rpx;text-align:center;padding-top:12rpx;box-sizing:border-box}
.live-swiper{height:164rpx}
.live-line{height:164rpx;display:grid;grid-template-columns:76rpx minmax(0,1fr) 88rpx;align-items:center;color:#ffd894;font-size:22rpx}
.live-user{font-weight:900}
.live-content{overflow:hidden;white-space:nowrap;text-overflow:ellipsis}
.live-time{font-size:18rpx;text-align:right;color:#e7a953}
.stats-panel{position:relative;z-index:2;margin-top:18rpx;padding:20rpx;display:grid;grid-template-columns:1fr 2rpx 1fr;align-items:center;border:3rpx solid #efbd5c;border-radius:20rpx;background:linear-gradient(180deg,#fff9e9,#ffebc5)}
.stat-item{display:flex;align-items:center;justify-content:center;gap:12rpx}
.stat-item image{width:86rpx;height:86rpx}
.stat-item text{color:#7d4c3b;font-size:20rpx}
.stat-item view view{color:#a50d16;font-size:21rpx;font-weight:800}
.stat-item strong{font-size:49rpx;line-height:56rpx}
.stat-divider{height:75rpx;background:#e4bd7b}
.subsection-ribbon{position:relative;z-index:2;top:auto;left:auto;width:max-content;min-width:430rpx;margin:54rpx auto 0;transform:none}
.gift-grid{position:relative;z-index:2;margin-top:18rpx;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:15rpx}
.gift-card{overflow:hidden;min-width:0;padding:13rpx 13rpx 16rpx;border:3rpx solid #f2bd58;border-radius:18rpx;background:linear-gradient(180deg,#fffdf8,#fff0d7);box-sizing:border-box;box-shadow:0 12rpx 26rpx rgba(53,0,3,.26);text-align:center}
.gift-image{display:block;width:100%;height:235rpx;border-radius:12rpx;background:#fff}
.gift-placeholder{display:flex;align-items:center;justify-content:center;color:#b48460;font-size:23rpx}
.gift-name{margin-top:10rpx;height:62rpx;color:#321918;font-size:23rpx;line-height:31rpx;font-weight:800;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.gift-points{color:#c31620;font-size:20rpx}
.gift-points strong{font-size:32rpx}
.gift-action{width:190rpx;height:52rpx;margin:10rpx auto 0;border-radius:999rpx;background:linear-gradient(180deg,#e82f2e,#b80712);color:#fff3ca;font-size:23rpx;font-weight:900;line-height:52rpx}
.points-banner{position:relative;z-index:2;margin-top:24rpx;padding:19rpx 22rpx;display:grid;grid-template-columns:110rpx minmax(0,1fr) 105rpx;align-items:center;border:3rpx solid #e99d2b;border-radius:20rpx;background:linear-gradient(120deg,#a70c15,#e0282c,#9d0710);box-shadow:inset 0 0 20rpx rgba(255,204,74,.18)}
.points-banner image{width:100rpx;height:100rpx}
.points-banner view{text-align:center}
.points-banner strong,.points-banner text{display:block}
.points-banner strong{color:#fff0bd;font-size:30rpx}
.points-banner text{margin-top:5rpx;color:#ffd47a;font-size:21rpx}
.data-empty{position:relative;z-index:2;margin-top:20rpx;padding:55rpx 20rpx;border:2rpx dashed rgba(255,205,113,.48);border-radius:18rpx;color:#f1c7b5;text-align:center}
.featured-merchant{position:relative;z-index:2;margin-top:30rpx;padding:18rpx;display:grid;grid-template-columns:275rpx minmax(0,1fr) 132rpx;gap:16rpx;align-items:center;border:3rpx solid #e8a741;border-radius:22rpx;background:linear-gradient(180deg,#fffaf0,#ffebcf);box-shadow:0 14rpx 30rpx rgba(49,0,2,.28)}
.featured-label{position:absolute;left:-2rpx;top:-24rpx;padding:10rpx 24rpx;border-radius:12rpx 12rpx 12rpx 0;background:#d3222a;color:#fff4d1;font-size:23rpx;font-weight:900}
.featured-cover{width:275rpx;height:205rpx;border-radius:14rpx;background:#f4e4d2}
.merchant-placeholder{display:flex;align-items:center;justify-content:center;color:#a16a54;font-size:22rpx;text-align:center}
.featured-copy{min-width:0}
.merchant-name{color:#351b18;font-size:29rpx;font-weight:900;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}
.featured-copy .merchant-name{height:74rpx;line-height:37rpx;white-space:normal;text-overflow:clip;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical}
.merchant-name.small{margin-top:10rpx;font-size:24rpx}
.merchant-tags{margin-top:9rpx;display:flex;gap:8rpx}
.merchant-tags text{padding:4rpx 9rpx;border:1rpx solid #d27623;border-radius:5rpx;color:#b04f08;font-size:17rpx}
.merchant-tags text.active{border-color:#4da764;color:#218441;background:#eff9f1}
.merchant-address{margin-top:10rpx;color:#75564d;font-size:19rpx;line-height:28rpx}
.merchant-address.line{height:54rpx;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.merchant-desc{margin-top:7rpx;color:#8a6b60;font-size:19rpx;line-height:27rpx}
.featured-coupon{padding:16rpx 8rpx;border:2rpx solid #e9b35e;border-radius:15rpx;color:#a30d16;background:#fff7e7;text-align:center}
.featured-coupon text,.featured-coupon strong{display:block}
.featured-coupon text{font-size:17rpx}
.featured-coupon strong{font-size:51rpx;line-height:61rpx}
.merchant-grid{position:relative;z-index:2;margin-top:16rpx;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14rpx}
.merchant-card{min-width:0;padding:13rpx;border:3rpx solid #e6a849;border-radius:18rpx;background:linear-gradient(180deg,#fffaf0,#ffebcd);box-sizing:border-box;box-shadow:0 10rpx 22rpx rgba(48,0,2,.24)}
.merchant-media{position:relative}
.merchant-cover{display:block;width:100%;height:180rpx;border-radius:12rpx;background:#f4e4d2}
.merchant-type-icon{position:absolute;right:9rpx;bottom:9rpx;width:60rpx;height:60rpx;border-radius:50%;background:#fff}
.merchant-support{margin-top:11rpx;padding-top:10rpx;border-top:1rpx solid #e9c9a0;color:#b7131d;font-size:18rpx;font-weight:800}
.merchant-support text{float:right;font-size:17rpx}
.redeem-panel{position:relative;z-index:2;margin-top:24rpx;padding:22rpx 15rpx;border:3rpx solid #efb751;border-radius:22rpx;background:linear-gradient(180deg,#fffaf0,#ffebc9)}
.subsection-title{color:#781617;font-size:31rpx;font-weight:900;text-align:center}
.redeem-steps{margin-top:20rpx;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8rpx}
.redeem-step{position:relative;display:flex;align-items:center;gap:8rpx}
.redeem-step image{width:72rpx;height:72rpx;flex:0 0 72rpx}
.redeem-step strong,.redeem-step text{display:block}
.redeem-step strong{font-size:22rpx}
.redeem-step text{margin-top:3rpx;color:#8f6b5c;font-size:16rpx}
.redeem-arrow{position:absolute;right:-9rpx;color:#c52328;font-size:42rpx}
.merchant-bottom-grid{position:relative;z-index:2;margin-top:24rpx;display:grid;grid-template-columns:1fr;gap:18rpx}
.faq-panel,.manager-service-card{overflow:hidden;border:3rpx solid #e6a444;border-radius:22rpx;background:linear-gradient(180deg,#fffaf0,#ffebcd)}
.faq-title{padding:18rpx 20rpx;background:#bd111b;color:#fff1c4;font-size:27rpx;font-weight:900}
.faq-item{border-top:1rpx solid #e7c89d}
.faq-question{min-height:70rpx;padding:0 18rpx;display:grid;grid-template-columns:30rpx minmax(0,1fr) 28rpx;align-items:center;gap:8rpx;color:#5f342b;font-size:21rpx}
.faq-question>text{color:#c4101b}
.faq-question>view{color:#bd111b;font-size:31rpx;text-align:right}
.faq-answer{padding:0 56rpx 18rpx;color:#89685d;font-size:20rpx;line-height:31rpx}
.manager-service-card{position:relative;padding:52rpx 24rpx 24rpx}
.manager-service-ribbon{position:absolute;left:50%;top:0;width:330rpx;height:52rpx;margin-left:-165rpx;border-radius:0 0 18rpx 18rpx;background:#edaa3d;color:#7c1614;font-size:23rpx;font-weight:900;line-height:52rpx;text-align:center}
.manager-service-head{display:flex;align-items:center}
.service-avatar{width:110rpx;height:110rpx;flex:0 0 110rpx;border:4rpx solid #e6a343;border-radius:50%;background:#f3dfc8}
.service-avatar.fallback{display:flex;align-items:center;justify-content:center;color:#b70e19;font-size:39rpx;font-weight:900}
.service-copy{min-width:0;margin-left:18rpx}
.service-copy strong,.service-copy text,.service-copy view{display:block}
.service-copy strong{font-size:31rpx}
.service-copy text{margin-top:2rpx;color:#c36614;font-size:20rpx}
.service-copy view{margin-top:6rpx;color:#76564b;font-size:20rpx}
.service-phone{margin-top:18rpx;padding:14rpx;border-radius:10rpx;background:#fff7e6;color:#4e3028;font-size:22rpx}
.service-button{height:74rpx;margin:18rpx 0 0;border:3rpx solid #ffc861;border-radius:999rpx;background:linear-gradient(180deg,#e82e2d,#b40611);color:#fff3c9;font-size:27rpx;font-weight:900;line-height:68rpx}
.service-button::after{border:0}
.final-cta{position:relative;z-index:2;margin-top:30rpx;padding:24rpx 20rpx 10rpx;text-align:center}
.final-cta>image{width:150rpx;height:150rpx;margin-bottom:-15rpx;animation:giftFloat 2.8s ease-in-out infinite}
.sticky-cta{position:fixed;z-index:45;left:16rpx;right:16rpx;bottom:calc(16rpx + env(safe-area-inset-bottom));min-height:98rpx;padding:13rpx 13rpx 13rpx 22rpx;display:flex;align-items:center;gap:14rpx;border:2rpx solid #efbb5a;border-radius:22rpx;background:rgba(255,249,234,.97);box-sizing:border-box;box-shadow:0 12rpx 34rpx rgba(53,0,3,.3)}
.sticky-copy{flex:1;min-width:0}
.sticky-copy strong{color:#751417;font-size:22rpx}
.sticky-copy strong text{color:#c90d1b;font-size:34rpx}
.sticky-copy view{margin-top:2rpx;color:#8b6b5d;font-size:18rpx}
.sticky-button{width:250rpx;flex:0 0 250rpx}
.page-loading{position:fixed;z-index:70;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:18rpx;background:rgba(125,5,13,.92);color:#ffe7a8;font-size:23rpx}
.loading-ring{width:58rpx;height:58rpx;border:6rpx solid rgba(255,220,145,.28);border-top-color:#ffc447;border-radius:50%;animation:spin .8s linear infinite}
.card-pressed{opacity:.9;transform:scale(.988)}
button::after{border:0}
@keyframes floatToken{0%,100%{margin-top:0;opacity:.75}
50%{margin-top:-14rpx;opacity:1}
}
@keyframes giftFloat{0%,100%{transform:translateY(0) rotate(-2deg)}
50%{transform:translateY(-12rpx) rotate(2deg)}
}
@keyframes spin{to{transform:rotate(360deg)}
}
