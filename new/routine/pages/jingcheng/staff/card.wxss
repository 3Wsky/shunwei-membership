page{background:#f7f3ea}.page{min-height:100vh;padding:28rpx 30rpx 56rpx;box-sizing:border-box;color:#372719}.state{padding:180rpx 30rpx;text-align:center;color:#866f57;font-size:28rpx}.state button{width:240rpx;margin-top:30rpx;border-radius:999rpx;background:#b88622;color:#fff;font-weight:700}.hero{padding:36rpx 32rpx;border-radius:24rpx;background:linear-gradient(135deg,#2d241b,#6b4512);color:#fff;box-shadow:0 14rpx 32rpx rgba(74,45,12,.18)}.hero-title{font-size:38rpx;font-weight:800}.hero-subtitle{margin-top:12rpx;color:#f4dfb7;font-size:24rpx;line-height:1.55}.form-card,.store-card{margin-top:22rpx;padding:8rpx 26rpx;border-radius:22rpx;background:#fffdf8;box-shadow:0 8rpx 24rpx rgba(84,57,20,.08)}.field{padding:24rpx 0;border-bottom:1rpx solid #f1e5ce}.field:last-child{border-bottom:0}.field text{display:block;margin-bottom:14rpx;color:#71552f;font-size:25rpx;font-weight:700}.field input,.field textarea{width:100%;min-height:44rpx;color:#342312;font-size:27rpx;line-height:1.5}.field textarea{min-height:104rpx}.switch-row{display:flex;align-items:center;justify-content:space-between;padding:25rpx 0}.switch-row text{display:block;color:#71552f;font-size:26rpx;font-weight:700}.switch-row label{display:block;margin-top:7rpx;color:#9d876e;font-size:22rpx}.store-card{padding:26rpx;color:#79654d;font-size:24rpx;line-height:1.8}.store-title{margin-bottom:8rpx;color:#5c421f;font-size:27rpx;font-weight:800}.save-button{margin-top:28rpx;border-radius:999rpx;background:linear-gradient(135deg,#d2a33f,#a86e10);color:#fff;font-size:30rpx;font-weight:800}.save-button::after{border:0}
