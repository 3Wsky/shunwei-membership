.page{padding-bottom:170rpx;background:#f6f5f2;color:#222}
.banner{height:640rpx;background:linear-gradient(180deg,#fff 0%,#f8f7f5 100%)}
.banner-item{padding:12rpx 20rpx 22rpx;box-sizing:border-box;display:flex;align-items:center;justify-content:center}
.banner-img{display:block;width:100%;height:606rpx;background:#fff;border-radius:12rpx}
.info{margin:24rpx;padding:30rpx;background:#fff;border-radius:20rpx;box-shadow:0 8rpx 24rpx rgba(31,31,31,.05)}
.brand-line{display:inline-flex;height:36rpx;padding:0 14rpx;border-radius:999rpx;background:#fff1e8;color:#c76b2d;font-size:20rpx;line-height:36rpx;margin-bottom:16rpx}
.name{font-size:38rpx;line-height:48rpx;font-weight:700;color:#1a1f36}
.price{margin-top:14rpx;font-size:42rpx;line-height:50rpx;color:#ff6a2a;font-weight:800}
.desc{margin-top:12rpx;font-size:26rpx;color:#666;line-height:1.6}
.summary-row{display:flex;flex-wrap:wrap;gap:10rpx;margin-top:18rpx}
.summary-tag{height:38rpx;padding:0 14rpx;border-radius:10rpx;background:#f7f3ed;color:#8b7562;font-size:21rpx;line-height:38rpx}
.section{margin:24rpx;padding:28rpx;background:#fff;border-radius:20rpx;box-shadow:0 8rpx 24rpx rgba(31,31,31,.04)}
.section-title{font-size:30rpx;line-height:38rpx;font-weight:700;margin-bottom:18rpx;color:#222}
.highlight-cloud{display:flex;align-items:center;flex-wrap:wrap;gap:14rpx 12rpx;padding:4rpx 0}
.highlight-chip{display:inline-flex;align-items:center;min-height:46rpx;padding:0 18rpx;border-radius:999rpx;background:#f8f7f5;color:#4d443c;font-size:23rpx;line-height:46rpx;box-sizing:border-box}
.highlight-chip.cloud-0{font-size:30rpx;font-weight:800;color:#d33b4b;background:#fff1f3}
.highlight-chip.cloud-1{font-size:27rpx;font-weight:700;color:#1f5d8f;background:#edf7ff}
.highlight-chip.cloud-2{font-size:25rpx;font-weight:700;color:#2f7a5b;background:#ebf8f1}
.highlight-chip.cloud-3{font-size:24rpx;color:#9b6b23;background:#fff7e6}
.highlight-chip.cloud-4{font-size:22rpx;color:#5d5570;background:#f3f1fb}
.highlight-chip.cloud-5{font-size:21rpx;color:#666;background:#f7f7f7}
.sku-picker{padding-bottom:30rpx}
.option-block+.option-block{margin-top:34rpx}
.option-title{font-size:28rpx;line-height:38rpx;color:#111;margin-bottom:18rpx}
.option-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16rpx 14rpx}
.option-cell{height:82rpx;border:1rpx solid #e5e1dc;border-radius:10rpx;background:#fff;display:flex;align-items:center;justify-content:center;padding:0 18rpx;box-sizing:border-box;font-size:25rpx;color:#111;overflow:hidden}
.option-cell.active{border-color:#ff6a2a;color:#ff6a2a;background:#fff8f3;box-shadow:0 8rpx 18rpx rgba(255,106,42,.08)}
.color-option{gap:14rpx}
.option-img{width:44rpx;height:44rpx;flex:0 0 44rpx}
.option-cell text{min-width:0;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}
.selected-sku{margin-top:22rpx;min-height:56rpx;padding:14rpx 18rpx;border-radius:14rpx;background:#faf7f2;display:flex;align-items:center;justify-content:space-between;gap:18rpx;color:#7d7166;font-size:23rpx;box-sizing:border-box}
.selected-price{color:#ff6a2a;font-weight:800;white-space:nowrap}
.color-scroll{white-space:nowrap}
.color-row{display:flex;gap:16rpx}
.color-card{width:158rpx;flex:0 0 158rpx;padding:12rpx;border:1rpx solid #f0eadf;border-radius:16rpx;background:#fffaf0;box-sizing:border-box}
.color-img{width:126rpx;height:126rpx;display:block}
.color-img.placeholder{display:flex;align-items:center;justify-content:center;background:#f2efe8;color:#999;font-size:24rpx}
.color-name{margin-top:8rpx;font-size:22rpx;color:#333;text-align:center;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.sku-group{border:1rpx solid #f0ece6;border-radius:18rpx;overflow:hidden;background:#fff}
.sku-group+.sku-group{margin-top:18rpx}
.sku-group-head{padding:18rpx;background:#fffaf5;border-bottom:1rpx solid #f0ece6}
.sku-color-info{display:flex;align-items:center;min-width:0}
.sku-color-img{width:88rpx;height:88rpx;flex:0 0 88rpx;border-radius:14rpx;background:#f4f2ef}
.sku-color-img.placeholder{display:flex;align-items:center;justify-content:center;color:#aaa;font-size:24rpx}
.sku-color-copy{min-width:0;flex:1;margin-left:16rpx}
.sku-color-name{font-size:28rpx;line-height:36rpx;font-weight:700;color:#222}
.sku-color-meta{margin-top:5rpx;font-size:22rpx;line-height:30rpx;color:#8b7562}
.sku-config-list{padding:0 18rpx}
.sku-config{display:flex;align-items:center;justify-content:space-between;gap:18rpx;padding:18rpx 0;border-bottom:1rpx solid #f2eee8}
.sku-config:last-child{border-bottom:0}
.sku-config-main{flex:1;min-width:0}
.sku-config-name{font-size:26rpx;color:#222;line-height:34rpx;font-weight:600}
.sku-config-version{margin-top:3rpx;font-size:21rpx;color:#888;line-height:28rpx;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}
.sku-code{margin-top:4rpx;font-size:20rpx;line-height:26rpx;color:#aaa}
.sku-config-price{font-size:28rpx;font-weight:800;color:#ff6a2a;white-space:nowrap}
.row{display:flex;padding:12rpx 0;border-bottom:1rpx solid #f1eee8;font-size:26rpx}
.label{width:180rpx;color:#888}
.value{flex:1;color:#333}
.detail-text{font-size:26rpx;line-height:42rpx;color:#555}
.detail-section{padding-bottom:20rpx}
.detail-img{display:block;width:100%;margin-top:14rpx;border-radius:14rpx;background:#f5f5f5}
.safe-bottom{height:20rpx}
.action-bar{position:fixed;left:0;right:0;bottom:0;z-index:30;height:112rpx;padding:12rpx 24rpx calc(12rpx + env(safe-area-inset-bottom));background:#fff;box-shadow:0 -8rpx 24rpx rgba(0,0,0,.08);display:flex;align-items:center;gap:18rpx;box-sizing:content-box}
.fav-btn{width:132rpx;height:84rpx;border:1rpx solid #f0e5dc;border-radius:16rpx;background:#fffaf7;display:flex;flex-direction:column;align-items:center;justify-content:center;color:#8a7060;font-size:21rpx;line-height:28rpx}
.fav-btn.active{color:#ff6a2a;border-color:#ffd2bf;background:#fff4ec}
.fav-icon{font-size:30rpx;line-height:32rpx}
.buy-btn{flex:1;height:84rpx;border-radius:16rpx;background:linear-gradient(90deg,#ff8a45,#ff6a2a);color:#fff;font-weight:800;display:flex;flex-direction:column;align-items:center;justify-content:center;box-shadow:0 10rpx 22rpx rgba(255,106,42,.24)}
.buy-main{font-size:32rpx;line-height:40rpx}
.drawer-mask{position:fixed;left:0;right:0;top:0;bottom:0;z-index:40;background:rgba(0,0,0,.42)}
.sku-drawer{position:fixed;left:0;right:0;bottom:0;z-index:41;max-height:78vh;background:#fff;border-radius:26rpx 26rpx 0 0;transform:translateY(110%);transition:transform .24s ease;box-sizing:border-box;padding:28rpx 30rpx calc(30rpx + env(safe-area-inset-bottom))}
.sku-drawer.show{transform:translateY(0)}
.drawer-head{display:flex;align-items:flex-start;position:relative;padding-right:48rpx}
.drawer-img{width:156rpx;height:156rpx;flex:0 0 156rpx;border-radius:18rpx;background:#f6f6f6}
.drawer-info{min-width:0;flex:1;margin-left:20rpx;padding-top:8rpx}
.drawer-price{font-size:42rpx;line-height:50rpx;color:#ff6a2a;font-weight:800}
.drawer-title{margin-top:8rpx;font-size:25rpx;line-height:34rpx;color:#222;overflow:hidden;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical}
.drawer-selected{margin-top:8rpx;font-size:22rpx;line-height:30rpx;color:#8a8179;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}
.drawer-close{position:absolute;right:0;top:0;width:44rpx;height:44rpx;border-radius:50%;background:#f3f3f3;color:#777;font-size:34rpx;line-height:40rpx;text-align:center}
.drawer-scroll{max-height:760rpx;margin-top:30rpx}
.drawer-option-block{margin-top:0;margin-bottom:36rpx}
.drawer-buy{height:86rpx;border-radius:16rpx;background:linear-gradient(90deg,#ff8a45,#ff6a2a);color:#fff;font-size:30rpx;font-weight:800;display:flex;align-items:center;justify-content:center;box-shadow:0 10rpx 22rpx rgba(255,106,42,.24)}
.advisor-mask{position:fixed;left:0;right:0;top:0;bottom:0;z-index:50;background:rgba(0,0,0,.42)}
.advisor-popup{position:fixed;left:0;right:0;bottom:0;z-index:51;transform:translateY(110%);transition:transform .24s ease;padding:0 24rpx calc(28rpx + env(safe-area-inset-bottom));box-sizing:border-box}
.advisor-popup.show{transform:translateY(0)}
.advisor-card{border-radius:24rpx;background:#fff;box-shadow:0 -10rpx 34rpx rgba(34,28,23,.16);overflow:hidden}
.advisor-top{position:relative;display:flex;align-items:center;padding:30rpx 76rpx 26rpx 30rpx;background:linear-gradient(135deg,#fff7ef,#fff)}
.advisor-avatar{width:94rpx;height:94rpx;flex:0 0 94rpx;border-radius:50%;background:#fff1e8;border:3rpx solid #fff;box-shadow:0 8rpx 20rpx rgba(139,90,45,.14)}
.advisor-avatar.fallback{display:flex;align-items:center;justify-content:center;color:#ff6a2a;font-size:34rpx;font-weight:800}
.advisor-main{min-width:0;flex:1;margin-left:18rpx}
.advisor-kicker{display:inline-flex;height:34rpx;padding:0 12rpx;border-radius:999rpx;background:#fff0e8;color:#c96b31;font-size:19rpx;line-height:34rpx}
.advisor-name{margin-top:8rpx;font-size:34rpx;line-height:42rpx;font-weight:800;color:#26211d;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}
.advisor-role{margin-top:4rpx;font-size:22rpx;line-height:30rpx;color:#8a7d72;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}
.advisor-close{position:absolute;right:28rpx;top:28rpx;width:46rpx;height:46rpx;border-radius:50%;background:#f5f1ed;color:#8a8179;font-size:34rpx;line-height:42rpx;text-align:center}
.advisor-tip{margin:0 30rpx;padding:18rpx 20rpx;border-radius:16rpx;background:#fff4ec;color:#c55e27;font-size:25rpx;line-height:34rpx;font-weight:700}
.advisor-selected{margin:16rpx 30rpx 0;padding:16rpx 20rpx;border-radius:14rpx;background:#f8f7f5;color:#70665d;font-size:23rpx;line-height:31rpx}
.advisor-info{padding:20rpx 30rpx 4rpx}
.advisor-row{display:flex;gap:18rpx;padding:15rpx 0;border-bottom:1rpx solid #f2eee9}
.advisor-row:last-child{border-bottom:0}
.advisor-label{width:72rpx;flex:0 0 72rpx;color:#9a8c80;font-size:23rpx;line-height:32rpx}
.advisor-value{flex:1;min-width:0;color:#302a25;font-size:25rpx;line-height:32rpx}
.advisor-actions{display:flex;gap:16rpx;padding:22rpx 30rpx 30rpx}
.advisor-action{flex:1;height:78rpx;border-radius:14rpx;display:flex;align-items:center;justify-content:center;font-size:27rpx;font-weight:700}
.advisor-action.secondary{border:1rpx solid #f0e5dc;background:#fffaf7;color:#8a7060}
.advisor-action.primary{background:linear-gradient(90deg,#ff8a45,#ff6a2a);color:#fff;box-shadow:0 10rpx 22rpx rgba(255,106,42,.22)}
.empty{padding:120rpx;text-align:center;color:#999}
