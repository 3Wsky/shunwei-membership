.page { min-height: 100vh; padding: 24rpx; background: #f5f5f5; box-sizing: border-box; }
.tip { font-size: 24rpx; color: #888; margin-bottom: 20rpx; }
.grid { display: flex; flex-wrap: wrap; justify-content: space-between; }
.card { width: calc(50% - 10rpx); background: #fff; border-radius: 16rpx; overflow: hidden; box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.06); margin-bottom: 20rpx; padding-bottom: 18rpx; box-sizing: border-box; }
.cover { width: 100%; height: 280rpx; display: block; background: #eee; }
.cover.placeholder { display: flex; align-items: center; justify-content: center; color: #aaa; font-size: 28rpx; }
.name { padding: 16rpx 16rpx 0; min-height: 66rpx; font-size: 26rpx; line-height: 33rpx; color: #222; font-weight: 700; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
.subtitle { margin: 8rpx 16rpx 0; min-height: 50rpx; font-size: 21rpx; line-height: 25rpx; color: #777; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
.tags { margin: 12rpx 16rpx 0; display: flex; gap: 8rpx; overflow: hidden; min-height: 32rpx; }
.tag { max-width: 128rpx; height: 32rpx; padding: 0 9rpx; border-radius: 8rpx; background: #fff2e8; color: #c76b2d; font-size: 18rpx; line-height: 32rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; box-sizing: border-box; }
.card-bottom { margin: 14rpx 16rpx 0; display: flex; align-items: flex-end; justify-content: space-between; gap: 8rpx; }
.price { font-size: 30rpx; font-weight: 700; color: #c76b2d; white-space: nowrap; }
.sku-summary { min-width: 0; flex: 1; text-align: right; color: #999; font-size: 19rpx; line-height: 24rpx; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.empty, .loading { text-align: center; color: #999; padding: 120rpx 0; font-size: 28rpx; }
.link-btn { margin-top: 24rpx; font-size: 26rpx; background: #1a1f36; color: #fff; border-radius: 999rpx; }
