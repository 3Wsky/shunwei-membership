<view class="page">
  <view class="balance-card">
    <view class="bc-bg"><text class="iconfont icon-jifenshangcheng"></text></view>
    <view class="bc-kicker">MEMBER REWARDS</view>
    <view class="bc-label">我的可用积分</view>
    <view class="bc-value">{{balance}}</view>
    <view class="bc-sub">积分兑换会员专享好礼</view>
    <view class="bc-line"></view>
    <view class="bc-foot">
      <view class="bc-foot-item"><text class="bc-dot"></text>到店领取</view>
      <view class="bc-foot-item"><text class="bc-dot"></text>专属权益</view>
    </view>
  </view>

  <view class="section-title">
    <view>
      <view class="section-heading">积分兑好礼</view>
      <view class="section-subtitle">精选会员兑换权益</view>
    </view>
    <view class="section-badge">{{products.length}} 件</view>
  </view>

  <view wx:if="{{products.length}}" class="grid">
    <view
      wx:for="{{products}}"
      wx:key="id"
      class="card"
      hover-class="card-hover"
      data-id="{{item.id}}"
      bindtap="openDetail"
    >
      <view class="cover-wrap">
        <image wx:if="{{item.image}}" class="cover" src="{{item.image}}" mode="aspectFit" />
        <view wx:else class="cover placeholder">兑</view>
        <view wx:if="{{!item.canExchange}}" class="cover-mask">{{item.stockHint || '暂不可兑'}}</view>
      </view>
      <view class="card-body">
        <view class="name">{{item.title}}</view>
        <view class="card-foot">
          <view class="price"><block wx:if="{{item.pricePending}}"><text>暂不可兑换</text></block><block wx:else><text class="price-num">{{item.price}}</text> 积分</block></view>
          <view class="go"><text class="iconfont icon-ic_rightarrow"></text></view>
        </view>
      </view>
    </view>
  </view>

  <view wx:elif="{{!loading}}" class="empty">
    <view class="empty-icon"><text class="iconfont icon-jifenshangcheng"></text></view>
    <view>积分商城暂无商品</view>
  </view>
  <view wx:if="{{loading}}" class="loading">加载中...</view>

  <view class="page-spacer"></view>
  <view class="mall-tabbar">
    <view class="tab-item" bindtap="goHome" hover-class="tab-pressed" hover-stay-time="100">
      <view class="tab-icon"><text class="iconfont icon-shouye"></text></view>
      <view class="tab-text">首页</view>
    </view>
    <view class="tab-item" bindtap="goCategory" hover-class="tab-pressed" hover-stay-time="100">
      <view class="tab-icon"><text class="iconfont icon-fenlei"></text></view>
      <view class="tab-text">分类</view>
    </view>
    <view class="tab-item active">
      <view class="tab-icon"><text class="iconfont icon-jifenshangcheng"></text></view>
      <view class="tab-text">积分商城</view>
      <view class="tab-active-dot"></view>
    </view>
    <view class="tab-item" bindtap="goMine" hover-class="tab-pressed" hover-stay-time="100">
      <view class="tab-icon"><text class="iconfont icon-geren"></text></view>
      <view class="tab-text">我的</view>
    </view>
  </view>
</view>
