page {
  background: #F5F3F0;
}

.page {
  min-height: 100vh;
  padding-bottom: 40rpx;
  box-sizing: border-box;
  color: #1A1A1A;
  background: #F5F3F0;
}

/* Hero image */
.hero {
  width: 100%;
  height: 700rpx;
  background: linear-gradient(180deg, #FFFFFF 0%, #F5F3F0 100%);
}

.hero-item,
.hero-single {
  padding: 34rpx 36rpx 44rpx;
  box-sizing: border-box;
}

.hero-img {
  display: block;
  width: 100%;
  height: 622rpx;
  border-radius: 12rpx;
  background: #FFFFFF;
}

.hero.placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 120rpx;
  font-weight: 900;
  background: linear-gradient(135deg, #1A1F36, #C9A227);
}

/* Info card */
.info-card {
  position: relative;
  margin: -40rpx 28rpx 0;
  padding: 30rpx;
  border-radius: 24rpx;
  background: #FFFFFF;
  border: 1rpx solid rgba(201, 162, 39, 0.08);
  box-shadow: 0 4rpx 24rpx rgba(0,0,0,0.04);
}

.price-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.price {
  color: #C9A227;
  font-size: 26rpx;
  font-weight: 700;
}

.price-num {
  font-size: 56rpx;
  font-weight: 900;
  line-height: 1;
}

.stock {
  color: #8C8C8C;
  font-size: 23rpx;
}

.title {
  margin-top: 18rpx;
  color: #1A1A1A;
  font-size: 36rpx;
  font-weight: 900;
  line-height: 1.35;
}

.subtitle {
  margin-top: 10rpx;
  color: #8C8C8C;
  font-size: 24rpx;
}

.tags {
  display: flex;
  flex-wrap: wrap;
  margin-top: 20rpx;
}

.tag {
  padding: 6rpx 18rpx;
  border-radius: 12rpx;
  font-size: 21rpx;
  font-weight: 700;
  margin-right: 14rpx;
  margin-bottom: 14rpx;
}

.tag.gold {
  color: #8C7355;
  background: #FBF8F5;
}

.tag.blue {
  color: #C9A227;
  background: #FFF9E6;
}

.tag.plain {
  color: #8C8C8C;
  background: #F5F3F0;
}

/* Rule card */
.rule-card {
  margin: 22rpx 28rpx 0;
  padding: 10rpx 30rpx;
  border-radius: 24rpx;
  background: #FFFFFF;
  border: 1rpx solid rgba(201, 162, 39, 0.08);
  box-shadow: 0 4rpx 24rpx rgba(0,0,0,0.04);
}

.rule-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #F0F4FA;
}

.rule-row:last-child {
  border-bottom: 0;
}

.rk {
  display: flex;
  align-items: center;
  color: #8C8C8C;
  font-size: 25rpx;
}

.rk .iconfont {
  margin-right: 12rpx;
  color: #C9A227;
  font-size: 30rpx;
}

.rv {
  max-width: 56%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: #1A1A1A;
  font-size: 26rpx;
  font-weight: 700;
}

.rv.gold {
  color: #C9A227;
  font-size: 30rpx;
  font-weight: 900;
}

.rv.muted {
  color: #8C8C8C;
  font-weight: 400;
}

/* Description */
.section-title {
  margin: 34rpx 32rpx 16rpx;
  color: #1A1A1A;
  font-size: 32rpx;
  font-weight: 800;
}

.desc-card {
  margin: 0 28rpx;
  padding: 30rpx;
  border-radius: 24rpx;
  background: #FFFFFF;
  border: 1rpx solid rgba(201, 162, 39, 0.08);
  box-shadow: 0 4rpx 24rpx rgba(0,0,0,0.04);
  font-size: 27rpx;
  line-height: 1.7;
  color: #4A4A4A;
}

.desc-card rich-text image,
.desc-card rich-text img {
  max-width: 100%;
}

.desc-empty {
  text-align: center;
  padding: 30rpx 10rpx;
}

.de-title {
  color: #1A1A1A;
  font-size: 28rpx;
  font-weight: 800;
}

.de-sub {
  margin-top: 12rpx;
  color: #8C8C8C;
  font-size: 24rpx;
  line-height: 1.6;
}

/* Exchange dialog */
.exchange-mask {
  position: fixed;
  z-index: 60;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  box-sizing: border-box;
  background: rgba(24, 20, 16, 0.48);
}

.exchange-dialog {
  position: relative;
  width: 100%;
  max-width: 640rpx;
  padding: 40rpx 34rpx 30rpx;
  border-radius: 28rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, #FFFDF9 0%, #FFFFFF 42%);
  box-shadow: 0 28rpx 70rpx rgba(17, 13, 9, 0.24);
  animation: exchange-dialog-pop 240ms cubic-bezier(0.2, 0.85, 0.3, 1) both;
}

.exchange-close {
  position: absolute;
  right: 22rpx;
  top: 20rpx;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  color: #9B8F84;
  background: #F6F1EA;
  font-size: 34rpx;
  line-height: 44rpx;
  text-align: center;
}

.exchange-badge {
  width: 66rpx;
  height: 66rpx;
  margin: 0 auto 16rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #A56E28;
  background: linear-gradient(135deg, #FFF2D6, #F9D89A);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.8);
}

.exchange-badge .iconfont {
  font-size: 36rpx;
}

.exchange-heading {
  color: #241D17;
  font-size: 36rpx;
  font-weight: 800;
  line-height: 46rpx;
  text-align: center;
}

.exchange-subheading {
  margin-top: 6rpx;
  color: #95887C;
  font-size: 23rpx;
  line-height: 32rpx;
  text-align: center;
}

.exchange-product {
  display: flex;
  align-items: center;
  margin-top: 30rpx;
  padding: 16rpx;
  border-radius: 18rpx;
  background: #FAF7F2;
}

.exchange-product-img {
  width: 104rpx;
  height: 104rpx;
  flex: 0 0 104rpx;
  border-radius: 14rpx;
  background: #FFFFFF;
}

.exchange-product-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #C9A227;
  font-size: 42rpx;
  font-weight: 800;
}

.exchange-product-main {
  min-width: 0;
  flex: 1;
  margin-left: 18rpx;
}

.exchange-product-name {
  overflow: hidden;
  color: #30271F;
  font-size: 27rpx;
  line-height: 36rpx;
  font-weight: 700;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.exchange-product-stock {
  margin-top: 8rpx;
  color: #9D8F80;
  font-size: 21rpx;
}

.exchange-points-row {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-top: 26rpx;
}

.exchange-points-label {
  color: #9A8E83;
  font-size: 21rpx;
  line-height: 30rpx;
}

.exchange-points {
  margin-top: 2rpx;
  color: #AF762C;
  font-size: 23rpx;
  font-weight: 700;
}

.exchange-points text {
  margin-right: 4rpx;
  font-size: 46rpx;
  line-height: 54rpx;
  font-weight: 900;
}

.exchange-balance {
  padding-bottom: 4rpx;
  color: #4B4037;
  font-size: 27rpx;
  line-height: 36rpx;
  font-weight: 700;
  text-align: right;
}

.exchange-note {
  margin-top: 24rpx;
  padding: 14rpx 16rpx;
  border-radius: 12rpx;
  color: #8B7864;
  background: #FFF7E8;
  font-size: 21rpx;
  line-height: 31rpx;
}

.exchange-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 28rpx;
}

.exchange-button {
  flex: 1;
  height: 82rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 27rpx;
  font-weight: 800;
  transition: opacity 160ms ease, transform 160ms ease;
}

.exchange-button.cancel {
  color: #766A5F;
  background: #F5F1EB;
}

.exchange-button.confirm {
  color: #FFFFFF;
  background: linear-gradient(135deg, #E8B84E, #C99432);
  box-shadow: 0 10rpx 22rpx rgba(194, 135, 49, 0.25);
}

.exchange-button.disabled {
  opacity: 0.6;
}

.exchange-button-pressed {
  opacity: 0.76;
  transform: scale(0.97);
}

.exchange-success-dialog {
  padding-top: 52rpx;
}

.success-check {
  width: 92rpx;
  height: 92rpx;
  margin: 0 auto 18rpx;
  border-radius: 50%;
  color: #FFFFFF;
  background: linear-gradient(135deg, #5AC88B, #28A968);
  box-shadow: 0 12rpx 26rpx rgba(40, 169, 104, 0.28);
  font-size: 60rpx;
  font-weight: 800;
  line-height: 90rpx;
  text-align: center;
  animation: success-check-pop 460ms cubic-bezier(.18, 1.35, .3, 1) both;
}

.success-reminder {
  margin-top: 24rpx;
  padding: 16rpx 18rpx;
  border-radius: 14rpx;
  color: #6F806F;
  background: #F2F9F4;
  font-size: 23rpx;
  line-height: 34rpx;
  text-align: center;
}

@keyframes success-check-pop {
  from { opacity: 0; transform: scale(.42) rotate(-18deg); }
  70% { opacity: 1; transform: scale(1.14) rotate(3deg); }
  to { opacity: 1; transform: scale(1) rotate(0); }
}

@keyframes exchange-dialog-pop {
  from { transform: translateY(26rpx) scale(0.96); opacity: 0; }
  to { transform: translateY(0) scale(1); opacity: 1; }
}

/* Bottom bar */
.bottom-spacer {
  height: 140rpx;
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  padding: 16rpx 28rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #FFFFFF;
  border-top: 1rpx solid #EBF0F7;
  box-shadow: 0 -6rpx 24rpx rgba(0, 0, 0, 0.04);
}

.bb-left {
  display: flex;
  flex-direction: column;
  margin-right: 24rpx;
}

.bb-num {
  color: #C9A227;
  font-size: 36rpx;
  font-weight: 900;
  line-height: 1;
}

.bb-label {
  margin-top: 6rpx;
  color: #8C8C8C;
  font-size: 20rpx;
}

.bb-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 44rpx;
  color: #fff;
  font-size: 30rpx;
  font-weight: 800;
  background: linear-gradient(135deg, #E6B84E, #C9A227);
  box-shadow: 0 6rpx 16rpx rgba(201, 162, 39, 0.2);
}

.bb-btn.disabled {
  color: #fff;
  background: #BCC6D6;
  box-shadow: none;
}
