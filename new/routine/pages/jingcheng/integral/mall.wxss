page {
  background: #FAF7F2;
}

.page {
  min-height: 100vh;
  padding: 26rpx 24rpx 180rpx;
  box-sizing: border-box;
  color: #29231E;
  background: #FAF7F2;
}

.balance-card {
  position: relative;
  min-height: 306rpx;
  overflow: hidden;
  padding: 32rpx 34rpx 28rpx;
  border: 1rpx solid #F0D9BA;
  border-radius: 28rpx;
  box-sizing: border-box;
  color: #473522;
  background: linear-gradient(125deg, #FFF9ED 0%, #FBE8CF 48%, #F8D8A8 100%);
  box-shadow: 0 12rpx 30rpx rgba(151, 101, 46, 0.12);
}

.bc-bg { position: absolute; z-index: 1; top: 38rpx; right: 30rpx; color: rgba(159, 100, 36, 0.17); }
.bc-bg .iconfont { font-size: 164rpx; }
.bc-kicker { position: relative; z-index: 2; color: #B17A38; font-size: 19rpx; font-weight: 800; letter-spacing: 2rpx; }
.bc-label { position: relative; z-index: 2; margin-top: 16rpx; color: #70563B; font-size: 24rpx; }
.bc-value { position: relative; z-index: 2; margin: 6rpx 0 7rpx; color: #4B3521; font-size: 70rpx; font-weight: 900; line-height: 1; }
.bc-sub { position: relative; z-index: 2; color: #8E704F; font-size: 22rpx; }
.bc-line { position: relative; z-index: 2; height: 1rpx; margin-top: 28rpx; background: rgba(162, 112, 56, 0.24); }
.bc-foot { position: relative; z-index: 2; margin-top: 16rpx; display: flex; gap: 28rpx; color: #9C774B; font-size: 20rpx; }
.bc-foot-item { display: flex; align-items: center; }
.bc-dot { width: 7rpx; height: 7rpx; margin-right: 8rpx; border-radius: 50%; background: #CF9142; }

.section-title { margin: 32rpx 4rpx 20rpx; display: flex; align-items: flex-end; justify-content: space-between; }
.section-heading { color: #2C251E; font-size: 35rpx; font-weight: 800; line-height: 44rpx; }
.section-subtitle { margin-top: 4rpx; color: #9A8D82; font-size: 21rpx; }
.section-badge { min-width: 64rpx; height: 40rpx; padding: 0 13rpx; box-sizing: border-box; border: 1rpx solid #E9DDD1; border-radius: 21rpx; color: #8B7D70; background: #FFFDF9; font-size: 20rpx; line-height: 38rpx; text-align: center; }

.grid { display: flex; flex-wrap: wrap; justify-content: space-between; }
.card { width: calc(50% - 9rpx); margin-bottom: 18rpx; overflow: hidden; border: 1rpx solid #F0E8E0; border-radius: 22rpx; box-sizing: border-box; background: #FFFFFF; box-shadow: 0 8rpx 23rpx rgba(107, 73, 39, 0.06); transition: opacity 150ms ease, transform 150ms ease; }
.card-hover { opacity: 0.83; transform: scale(0.98); }
.cover-wrap { position: relative; height: 312rpx; margin: 10rpx 10rpx 0; overflow: hidden; border-radius: 17rpx; background: #F8F6F3; }
.cover { width: 100%; height: 100%; }
.cover.placeholder { display: flex; align-items: center; justify-content: center; color: #B88B53; background: #F8E8D1; font-size: 64rpx; font-weight: 900; }
.cover-mask { position: absolute; right: 0; bottom: 0; left: 0; padding: 12rpx 0; color: #FFFFFF; background: rgba(55, 43, 33, 0.56); font-size: 21rpx; text-align: center; }
.card-body { padding: 16rpx 17rpx 18rpx; }
.name { height: 70rpx; overflow: hidden; color: #302923; font-size: 26rpx; font-weight: 700; line-height: 35rpx; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
.card-foot { min-height: 52rpx; margin-top: 12rpx; display: flex; align-items: center; justify-content: space-between; }
.price { color: #B5782D; font-size: 21rpx; font-weight: 700; }
.price-num { color: #A96721; font-size: 36rpx; font-weight: 900; line-height: 1; }
.go { width: 46rpx; height: 46rpx; border-radius: 50%; color: #FFFFFF; background: #FF6A2A; box-shadow: 0 6rpx 13rpx rgba(255, 106, 42, 0.2); font-size: 20rpx; line-height: 46rpx; text-align: center; }
.go .iconfont { font-size: 21rpx; }

.empty { display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 120rpx 0; color: #9A8D82; font-size: 26rpx; }
.empty-icon { width: 120rpx; height: 120rpx; margin-bottom: 18rpx; border-radius: 36rpx; color: #B88B53; background: #F8E8D1; line-height: 120rpx; text-align: center; }
.empty-icon .iconfont { font-size: 60rpx; }
.loading { padding: 72rpx 0; color: #9A8D82; font-size: 24rpx; text-align: center; }
.page-spacer { height: 20rpx; }

.mall-tabbar { position: fixed; z-index: 100; right: 0; bottom: 0; left: 0; min-height: 104rpx; padding: 8rpx 26rpx calc(8rpx + env(safe-area-inset-bottom)); box-sizing: border-box; display: flex; align-items: center; justify-content: space-around; border-top: 1rpx solid rgba(234, 225, 216, 0.9); background: rgba(255, 255, 255, 0.97); box-shadow: 0 -8rpx 22rpx rgba(78, 55, 34, 0.08); }
.tab-item { position: relative; width: 25%; height: 92rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; color: #8E857D; transition: opacity 140ms ease, transform 140ms ease; }
.tab-icon { width: 48rpx; height: 48rpx; display: flex; align-items: center; justify-content: center; border-radius: 17rpx; }
.tab-icon .iconfont { font-size: 34rpx; }
.tab-text { margin-top: 1rpx; font-size: 20rpx; line-height: 28rpx; }
.tab-item.active { color: #F15D2B; }
.tab-item.active .tab-icon { color: #FFFFFF; background: linear-gradient(135deg, #FF8750, #FF5F2B); box-shadow: 0 7rpx 14rpx rgba(255, 106, 42, 0.2); }
.tab-item.active .tab-text { font-weight: 700; }
.tab-active-dot { position: absolute; bottom: 0; width: 18rpx; height: 5rpx; border-radius: 3rpx; background: #FF6A2A; }
.tab-pressed { opacity: 0.72; transform: translateY(2rpx); }
