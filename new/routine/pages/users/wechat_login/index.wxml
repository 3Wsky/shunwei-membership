<view class="wrapper" style="{{colorStyle}}">
  <view class="ambient-glow glow-top"></view>
  <view class="ambient-glow glow-card"></view>
  <view class="curve-decoration curve-right"><view></view><view></view><view></view></view>

  <view class="system-height" style="height:{{statusBarHeight}};"></view>
  <view class="title-bar">
    <block wx:if="{{!isHome}}">
      <view data-event-opts="{{[['tap',[['back',['$event']]]]]}}" class="nav-button" bindtap="__e">
        <image src="../static/left.png"></image>
      </view>
    </block>
    <block wx:else>
      <view data-event-opts="{{[['tap',[['home',['$event']]]]]}}" class="nav-button" bindtap="__e">
        <image src="../static/home.png"></image>
      </view>
    </block>
    <text>会员登录</text>
  </view>

  <view class="login-content">
    <view class="brand-area">
      <view class="brand-emblem">
        <image class="brand-logo" src="{{configData.wap_login_logo}}" mode="aspectFit"></image>
      </view>
      <view class="brand-diamond"></view>
      <view class="brand-name">锦程祥瑞数码</view>
      <view class="brand-subtitle">您的专属手机管家</view>
      <view class="brand-divider"><view class="divider-line"></view><view class="divider-diamond"></view><text>MEMBER SERVICE</text><view class="divider-diamond"></view><view class="divider-line"></view></view>
    </view>

    <view class="login-card">
      <view class="member-watermark"><view class="watermark-crown">♛</view><text>V</text></view>
      <view class="card-kicker">WELCOME BACK</view>
      <view class="kicker-line"></view>
      <view class="card-title">欢迎登录会员中心</view>
      <view class="card-desc">授权后即可查看积分、现金券与专属会员权益</view>

      <view class="wechat_login">
        <view class="btn-wrapper">
          <block wx:if="{{configData.wechat_auth_switch}}">
            <block wx:if="{{bindPhone}}">
              <button class="wechat-btn" open-type="getPhoneNumber" data-event-opts="{{[['getphonenumber',[['getphonenumber',['$event']]]]]}}" bindgetphonenumber="__e">
                <text>授权登录</text>
                <view class="button-spark">✦</view>
              </button>
            </block>
            <block wx:else>
              <button data-event-opts="{{[['tap',[['getAuthLogin',['$event']]]]]}}" class="wechat-btn" bindtap="__e">
                <text>授权登录</text>
                <view class="button-spark">✦</view>
              </button>
            </block>
          </block>

          <view class="secure-tip">
            <text class="secure-mark">✓</text>
            <text>仅用于会员身份验证 · 信息加密保护</text>
          </view>
          <view class="cancel-row">
            <view class="cancel-line"></view>
            <view data-event-opts="{{[['tap',[['onReject',['$event']]]]]}}" class="cancel-login" bindtap="__e">暂不登录</view>
            <view class="cancel-line"></view>
          </view>
        </view>
      </view>

      <block wx:if="{{!canGetPrivacySetting}}">
        <view class="protocol">
          <checkbox-group data-event-opts="{{[['tap',[['ChangeIsDefault',['$event']]]]]}}" catchtap="__e">
            <checkbox class="{{inAnimation?'trembling':''}}" checked="{{protocol?true:false}}" data-event-opts="{{[['animationend',[['e0',['$event']]]]]}}" bindanimationend="__e"></checkbox>
            <text data-event-opts="{{[['tap',[['ChangeIsDefault',['$event']]]]]}}" catchtap="__e">{{$root.m4}}</text>
            <text data-event-opts="{{[['tap',[['privacy',[4]]]]]}}" class="main-color" catchtap="__e">{{$root.m5}}</text>
            {{''+$root.m6}}
            <text data-event-opts="{{[['tap',[['privacy',[3]]]]]}}" class="main-color" catchtap="__e">{{$root.m7}}</text>
          </checkbox-group>
        </view>
      </block>
    </view>

    <view class="page-foot">
      <view class="foot-mark"><view class="foot-line"></view><view class="foot-diamond"></view><text>V</text><view class="foot-diamond"></view><view class="foot-line"></view></view>
      <view class="foot-text">锦程祥瑞数码会员服务</view>
    </view>
  </view>

  <view class="bottom-ribbon ribbon-back"></view>
  <view class="bottom-ribbon ribbon-front"></view>

  <block wx:if="{{isUp}}">
    <mobile-login vue-id="42503e73-1" isUp="{{isUp}}" canClose="{{canClose}}" authKey="{{authKey}}" data-event-opts="{{[['^close',[['maskClose']]],['^wechatPhone',[['wechatPhone']]]]}}" bind:close="__e" bind:wechatPhone="__e" bind:__l="__l"></mobile-login>
  </block>
  <block wx:if="{{isPhoneBox}}">
    <routine-phone vue-id="42503e73-2" logoUrl="{{logoUrl}}" isPhoneBox="{{isPhoneBox}}" authKey="{{authKey}}" data-event-opts="{{[['^loginSuccess',[['bindPhoneClose']]]]}}" bind:loginSuccess="__e" bind:__l="__l"></routine-phone>
  </block>
  <edit-user-modal vue-id="42503e73-3" isShow="{{isShow}}" data-event-opts="{{[['^closeEdit',[['closeEdit']]],['^editSuccess',[['editSuccess']]]]}}" bind:closeEdit="__e" bind:editSuccess="__e" bind:__l="__l"></edit-user-modal>
  <block wx:if="{{canGetPrivacySetting}}">
    <privacy-agreement-popup bind:onReject="__e" bind:onAgree="__e" vue-id="42503e73-4" data-event-opts="{{[['^onReject',[['onReject']]],['^onAgree',[['onAgree']]]]}}" bind:__l="__l"></privacy-agreement-popup>
  </block>
</view>
