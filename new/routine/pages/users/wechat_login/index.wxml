<view class="wrapper" style="{{colorStyle}}">
  <view class="system-height" style="height:{{statusBarHeight}};"></view>
  <view class="title-bar">
    <block wx:if="{{!isHome}}">
      <view data-event-opts="{{[['tap',[['back',['$event']]]]]}}" class="nav-button" bindtap="__e">
        <image src="../static/left.png"></image>
      </view>
    </block>
    <block wx:else>
      <view data-event-opts="{{[['tap',[['home',['$event']]]]]}}" class="nav-button" bindtap="__e">
        <image src="../static/home.png"></image>
      </view>
    </block>
    <text>会员登录</text>
  </view>

  <view class="visual-page">
    <image class="visual-slice hero-slice" src="./static/login-hero.jpg" mode="widthFix"></image>

    <view class="card-slice-wrap">
      <image class="visual-slice card-slice" src="./static/login-card.jpg" mode="widthFix"></image>

      <block wx:if="{{configData.wechat_auth_switch}}">
        <block wx:if="{{bindPhone}}">
          <button
            class="auth-hit-button"
            open-type="getPhoneNumber"
            aria-label="授权登录"
            data-event-opts="{{[['getphonenumber',[['getphonenumber',['$event']]]]]}}"
            bindgetphonenumber="__e"
          ><text>授权登录</text></button>
        </block>
        <block wx:else>
          <button
            class="auth-hit-button"
            aria-label="授权登录"
            data-event-opts="{{[['tap',[['getAuthLogin',['$event']]]]]}}"
            bindtap="__e"
          ><text>授权登录</text></button>
        </block>
      </block>

      <button
        class="skip-hit-button"
        aria-label="暂不登录"
        data-event-opts="{{[['tap',[['onReject',['$event']]]]]}}"
        bindtap="__e"
      ><text>暂不登录</text></button>
    </view>

    <block wx:if="{{!canGetPrivacySetting}}">
      <view class="protocol-panel">
        <checkbox-group data-event-opts="{{[['tap',[['ChangeIsDefault',['$event']]]]]}}" catchtap="__e">
          <checkbox class="{{inAnimation?'trembling':''}}" checked="{{protocol?true:false}}" data-event-opts="{{[['animationend',[['e0',['$event']]]]]}}" bindanimationend="__e"></checkbox>
          <text data-event-opts="{{[['tap',[['ChangeIsDefault',['$event']]]]]}}" catchtap="__e">{{$root.m4}}</text>
          <text data-event-opts="{{[['tap',[['privacy',[4]]]]]}}" class="main-color" catchtap="__e">{{$root.m5}}</text>
          {{''+$root.m6}}
          <text data-event-opts="{{[['tap',[['privacy',[3]]]]]}}" class="main-color" catchtap="__e">{{$root.m7}}</text>
        </checkbox-group>
      </view>
    </block>

    <image class="visual-slice footer-slice" src="./static/login-footer.jpg" mode="widthFix" lazy-load="true"></image>
  </view>

  <block wx:if="{{isUp}}">
    <mobile-login vue-id="42503e73-1" isUp="{{isUp}}" canClose="{{canClose}}" authKey="{{authKey}}" data-event-opts="{{[['^close',[['maskClose']]],['^wechatPhone',[['wechatPhone']]]]}}" bind:close="__e" bind:wechatPhone="__e" bind:__l="__l"></mobile-login>
  </block>
  <block wx:if="{{isPhoneBox}}">
    <routine-phone vue-id="42503e73-2" logoUrl="{{logoUrl}}" isPhoneBox="{{isPhoneBox}}" authKey="{{authKey}}" data-event-opts="{{[['^loginSuccess',[['bindPhoneClose']]]]}}" bind:loginSuccess="__e" bind:__l="__l"></routine-phone>
  </block>
  <edit-user-modal vue-id="42503e73-3" isShow="{{isShow}}" data-event-opts="{{[['^closeEdit',[['closeEdit']]],['^editSuccess',[['editSuccess']]]]}}" bind:closeEdit="__e" bind:editSuccess="__e" bind:__l="__l"></edit-user-modal>
  <block wx:if="{{canGetPrivacySetting}}">
    <privacy-agreement-popup bind:onReject="__e" bind:onAgree="__e" vue-id="42503e73-4" data-event-opts="{{[['^onReject',[['onReject']]],['^onAgree',[['onAgree']]]]}}" bind:__l="__l"></privacy-agreement-popup>
  </block>
</view>
