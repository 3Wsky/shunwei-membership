page { background: #FFF9F0; }

.wrapper {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
  color: #3B2719;
  background: #FFF9F0;
}

.system-height { position: relative; z-index: 4; }
.title-bar { position: relative; z-index: 4; height: 92rpx; display: flex; align-items: center; justify-content: center; color: #302016; background: #FFF9F0; font-size: 34rpx; font-weight: 700; letter-spacing: 2rpx; }
.nav-button { position: absolute; top: 8rpx; left: 24rpx; width: 72rpx; height: 72rpx; display: flex; align-items: center; justify-content: center; box-sizing: border-box; border: 1rpx solid rgba(202, 160, 104, .42); border-radius: 50%; background: rgba(255, 253, 249, .9); box-shadow: 0 8rpx 24rpx rgba(111, 75, 37, .07); }
.nav-button image { width: 31rpx; height: 31rpx; }

.visual-page { position: relative; width: 750rpx; padding-bottom: env(safe-area-inset-bottom); background: #FFF9F0; }
.visual-slice { display: block; width: 750rpx; }
.hero-slice { height: 421rpx; }
.card-slice-wrap { position: relative; width: 750rpx; height: 531rpx; }
.card-slice { position: absolute; top: 0; left: 0; height: 531rpx; }
.footer-slice { height: 222rpx; }

.auth-hit-button,
.skip-hit-button { position: absolute; z-index: 3; margin: 0; padding: 0; overflow: visible; box-sizing: border-box; border: 0; color: transparent; background: transparent; line-height: 1; transition: transform .12s ease, background-color .12s ease, box-shadow .12s ease; }
.auth-hit-button::after,
.skip-hit-button::after { border: 0; }
.auth-hit-button text,
.skip-hit-button text { color: transparent; }

.auth-hit-button { top: 235rpx; left: 77rpx; width: 594rpx; height: 101rpx; border-radius: 54rpx; }
.auth-hit-button:active { background: rgba(146, 35, 10, .12); box-shadow: inset 0 0 0 2rpx rgba(255, 240, 210, .5); transform: scale(.98); }
.skip-hit-button { top: 431rpx; left: 247rpx; width: 256rpx; height: 76rpx; border-radius: 38rpx; }
.skip-hit-button:active { background: rgba(191, 142, 78, .09); transform: scale(.96); }

.protocol-panel { position: relative; z-index: 4; margin: -6rpx 54rpx 18rpx; padding: 18rpx 24rpx; border: 1rpx solid rgba(211, 179, 138, .38); border-radius: 18rpx; color: #917D6B; background: rgba(255, 253, 248, .94); font-size: 21rpx; line-height: 34rpx; text-align: center; box-shadow: 0 10rpx 26rpx rgba(103, 68, 34, .06); }
.protocol-panel .main-color { color: #B37834; }
.protocol-panel .trembling { animation: shake .6s; }
.protocol-panel checkbox .wx-checkbox-input { width: 28rpx; height: 28rpx; margin-right: 7rpx; border-color: #D8C8B7; border-radius: 8rpx; }
.protocol-panel checkbox .wx-checkbox-input.wx-checkbox-input-checked { border-color: #C18A48; background: #C18A48; }

@keyframes shake { 0%, 100% { transform: translateX(0); } 25% { transform: translateX(-8rpx); } 75% { transform: translateX(8rpx); } }
