<view class="home-page">
  <view class="top-shell" style="padding-top: {{statusBarHeight}}px; padding-right: {{capsuleSpace}}px;">
    <view class="brand-block">
      <view class="brand-name">锦程祥瑞数码</view>
      <view class="brand-subtitle">您的专属手机管家</view>
    </view>
    <view class="search-pill" bindtap="goSearch">
      <view class="search-mark"></view>
      <text>搜索手机/配件/服务</text>
    </view>
  </view>

  <view class="home-content">
    <swiper class="banner-swiper" autoplay="true" circular="true" interval="4200" duration="500" bindchange="bannerChange">
      <block wx:for="{{banners}}" wx:key="index">
        <swiper-item>
          <view class="banner-card">
            <view class="banner-copy">
              <view class="banner-kicker">MEMBER BENEFITS</view>
              <view class="banner-title">{{item.title}}</view>
              <view class="banner-subtitle">{{item.subtitle}}</view>
              <view class="banner-button" bindtap="goPointsMall">查看积分商城</view>
            </view>
            <view class="gift-stage">
              <view class="gift-halo"></view>
              <block wx:if="{{bannerImages.length}}">
                <image wx:for="{{bannerImages}}" wx:for-item="img" wx:for-index="imgIndex" wx:key="imgIndex" class="gift-img gift-img-{{imgIndex}}" src="{{img}}" mode="aspectFit"></image>
              </block>
              <block wx:else>
                <view class="gift-box large"></view>
                <view class="gift-box small"></view>
                <view class="gift-pad"></view>
              </block>
            </view>
          </view>
        </swiper-item>
      </block>
    </swiper>
    <view class="banner-dots">
      <view wx:for="{{banners}}" wx:key="index" class="dot {{bannerIndex === index ? 'active' : ''}}"></view>
    </view>

    <view class="member-card card" bindtap="goMember">
      <view class="member-watermark one"></view>
      <view class="member-watermark two"></view>
      <view class="member-main">
        <image class="member-avatar" src="{{member.avatar}}" mode="aspectFill"></image>
        <view class="member-info">
          <view class="member-name-row">
            <text class="member-name">{{member.nickname}}</text>
            <text class="member-level">{{member.level}}</text>
          </view>
          <view class="member-phone">{{member.phone}}</view>
        </view>
        <view class="metric">
          <view class="metric-value">{{member.integral}}</view>
          <view class="metric-label">积分余额</view>
        </view>
        <view class="metric-divider"></view>
        <view class="metric">
          <view class="metric-value">{{member.browseCount}}</view>
          <view class="metric-label">浏览记录</view>
        </view>
      </view>
      <view class="member-progress">
        <view class="progress-text">会员有效期：{{member.validUntil}}</view>
        <view class="progress-track"><view class="progress-fill"></view></view>
        <view class="member-link">会员中心 ></view>
      </view>
    </view>

    <view class="quick-card card">
      <view wx:for="{{quickEntries}}" wx:key="title" class="quick-item" data-url="{{item.url}}" bindtap="goQuick">
        <view class="quick-icon {{item.className}}">{{item.icon}}</view>
        <view class="quick-title">{{item.title}}</view>
      </view>
    </view>

    <view class="notice-card">
      <view class="notice-icon">告</view>
      <view class="notice-text">2026米东联盟消费券，火热发放中，先到先得！</view>
      <view class="notice-arrow">></view>
    </view>

    <view class="signin-card card">
      <view class="signin-top">
        <view class="signin-illustration">
          <view class="box-lid"></view>
          <view class="box-body"></view>
        </view>
        <view class="signin-copy">
          <view class="section-title compact">每日签到领积分 <text class="score-badge">+10</text></view>
          <view class="section-subtitle">连续签到得更多积分</view>
        </view>
        <view class="signin-button" bindtap="goSignIn">立即签到</view>
      </view>
      <view class="signin-days">
        <view wx:for="{{signDays}}" wx:key="day" class="day-card {{item.checked ? 'checked' : ''}} {{item.gift ? 'gift' : ''}}">
          <view class="day-reward">{{item.reward}}</view>
          <view wx:if="{{item.gift}}" class="day-gift">礼</view>
          <view wx:if="{{item.checked}}" class="day-check">✓</view>
          <view class="day-name">{{item.day}}</view>
        </view>
      </view>
    </view>

    <view class="points-section card">
      <view class="section-head">
        <view class="section-title">积分兑好礼</view>
        <view class="section-more" bindtap="goPointsMall">更多好礼 ></view>
      </view>
      <scroll-view class="points-scroll" scroll-x="true" show-scrollbar="false">
        <view class="points-row">
          <view wx:for="{{pointGoods}}" wx:key="id" class="point-good" data-id="{{item.id}}" bindtap="openPointGood">
            <view class="point-img-wrap">
              <image class="point-img" src="{{item.image}}" mode="aspectFit"></image>
            </view>
            <view class="point-info">
              <view class="point-title">{{item.title}}</view>
              <view class="point-price">{{item.points}}</view>
            </view>
          </view>
        </view>
      </scroll-view>
    </view>

    <view class="recommend-section">
      <view class="recommend-head">
        <view>
          <view class="section-title">精品推荐</view>
          <view class="recommend-sub">正品保障｜售后无忧｜分期免息</view>
        </view>
        <view class="section-more" data-url="/pages/jingcheng/showcase/list" bindtap="goQuick">全部 ></view>
      </view>
      <scroll-view class="product-scroll" scroll-x="true" show-scrollbar="false">
        <view class="product-row">
          <view wx:for="{{products}}" wx:key="id" class="product-card" data-id="{{item.id}}" bindtap="openProduct">
            <view class="product-img-wrap">
              <image class="product-img" src="{{item.image}}" mode="aspectFit"></image>
            </view>
            <view class="product-name">{{item.title}}</view>
            <view class="product-spec">{{item.spec}}</view>
            <view class="product-bottom">
              <view>
                <view class="product-price">¥{{item.price}}</view>
                <view class="product-sales">已售{{item.sales}}</view>
              </view>
              <view class="cart-plus" data-id="{{item.id}}" catchtap="openProduct">+</view>
            </view>
          </view>
        </view>
      </scroll-view>
      <view wx:if="{{!products.length && !loading}}" class="empty-tip">暂无推荐商品</view>
    </view>
  </view>

  <view class="home-tabbar">
    <view class="tab-item active">
      <view class="tab-icon">首</view>
      <view class="tab-text">首页</view>
    </view>
    <view class="tab-item" bindtap="goCategory">
      <view class="tab-icon">类</view>
      <view class="tab-text">分类</view>
    </view>
    <view class="tab-item" bindtap="goPointsMall">
      <view class="tab-icon">积</view>
      <view class="tab-text">积分商城</view>
    </view>
    <view class="tab-item" bindtap="goMine">
      <view class="tab-icon">我</view>
      <view class="tab-text">我的</view>
    </view>
  </view>
</view>
