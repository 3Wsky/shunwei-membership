<view class="home-page">
  <view class="top-shell" style="padding-top: calc({{statusBarHeight}}px + 18rpx); padding-right: {{capsuleSpace}}px;">
    <view class="brand-block">
      <view class="brand-name">锦程祥瑞数码</view>
      <view class="brand-subtitle">您的专属手机管家</view>
    </view>
    <view class="search-pill" bindtap="goSearch">
      <text class="iconfont icon-ic_search search-icon"></text>
      <text class="search-placeholder">搜索手机/配件/服务</text>
    </view>
  </view>

  <view class="home-content">
    <swiper class="banner-swiper" autoplay="true" circular="true" interval="4200" duration="500" bindchange="bannerChange">
      <block wx:for="{{banners}}" wx:key="index">
        <swiper-item>
          <view class="banner-card">
            <view class="banner-copy">
              <view class="banner-kicker">MEMBER BENEFITS</view>
              <view class="banner-title">{{item.title}}</view>
              <view class="banner-subtitle">{{item.subtitle}}</view>
              <view class="banner-button" bindtap="goPointsMall">
                <text>查看积分商城</text>
                <text class="iconfont icon-ic_rightarrow banner-button-arrow"></text>
              </view>
            </view>
            <view class="gift-stage">
              <view class="gift-halo"></view>
              <view class="gift-base"></view>
              <view class="gift-spark spark-one"></view>
              <view class="gift-spark spark-two"></view>
              <block wx:if="{{bannerImages.length}}">
                <image wx:for="{{bannerImages}}" wx:for-item="img" wx:for-index="imgIndex" wx:key="imgIndex" class="gift-img gift-img-{{imgIndex}}" src="{{img}}" mode="aspectFit"></image>
              </block>
              <block wx:else>
                <view class="gift-box large"></view>
                <view class="gift-box small"></view>
                <view class="gift-pad"></view>
              </block>
            </view>
          </view>
        </swiper-item>
      </block>
    </swiper>
    <view class="banner-dots">
      <view wx:for="{{banners}}" wx:key="index" class="dot {{bannerIndex === index ? 'active' : ''}}"></view>
    </view>

    <view class="member-card card" bindtap="goMember">
      <view class="member-watermark one"></view>
      <view class="member-watermark two"></view>
      <view class="member-main">
        <view class="member-identity">
          <image class="member-avatar" src="{{member.avatar}}" mode="aspectFill" binderror="avatarError"></image>
          <view class="member-info">
            <view class="member-name-row">
              <text class="member-name">{{member.nickname}}</text>
              <view class="member-level">
                <text class="member-level-vip">VIP</text>
                <text>{{member.level}}</text>
              </view>
            </view>
            <view class="member-phone">{{member.phone}}</view>
          </view>
        </view>
        <view class="member-metrics">
          <view class="metric integral-metric">
            <view class="metric-value {{member.integralClass}}">{{member.integral}}</view>
            <view class="metric-label">积分余额</view>
          </view>
          <view class="metric-divider"></view>
          <view class="metric voucher-metric">
            <view class="metric-value {{member.cashVoucherClass}}"><text class="metric-currency">¥</text>{{member.cashVoucher}}</view>
            <view class="metric-label">现金券余额</view>
          </view>
        </view>
      </view>
      <view class="member-progress">
        <view class="progress-text">会员有效期：{{member.validUntil}}</view>
        <view class="progress-track"><view class="progress-fill"></view></view>
        <view class="member-link">会员中心 <text class="iconfont icon-ic_rightarrow"></text></view>
      </view>
    </view>

    <view class="quick-card card">
      <view wx:for="{{quickEntries}}" wx:key="title" class="quick-item" data-url="{{item.url}}" bindtap="goQuick">
        <view class="quick-icon {{item.className}}"><text class="iconfont {{item.icon}}"></text></view>
        <view class="quick-title">{{item.title}}</view>
      </view>
    </view>

    <view class="notice-card">
      <view class="notice-icon"><text class="iconfont icon-laba"></text></view>
      <view class="notice-label">公告</view>
      <view class="notice-text">2026米东联盟消费券，火热发放中，先到先得！</view>
      <text class="iconfont icon-ic_rightarrow notice-arrow"></text>
    </view>

    <view class="signin-card card">
      <view class="signin-top">
        <view class="signin-illustration">
          <view class="signin-glow"></view>
          <image class="signin-gift-img" src="/static/images/sign-icon-04.png" mode="aspectFit"></image>
        </view>
        <view class="signin-copy">
          <view class="section-title compact">每日签到领积分 <text class="score-badge">+10</text></view>
          <view class="section-subtitle">连续签到得更多积分</view>
        </view>
        <view class="signin-button" bindtap="goSignIn">立即签到</view>
      </view>
      <view class="signin-days">
        <view wx:for="{{signDays}}" wx:key="day" class="day-card {{item.checked ? 'checked' : ''}} {{item.gift ? 'gift' : ''}}">
          <view class="day-reward">{{item.reward}}</view>
          <view wx:if="{{item.gift}}" class="day-gift">礼</view>
          <view wx:if="{{item.checked}}" class="day-check">✓</view>
          <view class="day-name">{{item.day}}</view>
        </view>
      </view>
    </view>

    <view class="points-section card">
      <view class="section-head">
        <view class="section-title">积分兑好礼</view>
        <view class="section-more" bindtap="goPointsMall">更多好礼 <text class="iconfont icon-ic_rightarrow"></text></view>
      </view>
      <swiper class="points-swiper" autoplay="{{pointGoods.length > 2}}" circular="{{pointGoods.length > 2}}" interval="3600" duration="520" display-multiple-items="2" easing-function="easeInOutCubic">
        <swiper-item wx:for="{{pointGoods}}" wx:key="id" class="point-slide">
          <view class="point-good" data-id="{{item.id}}" bindtap="openPointGood">
            <view class="point-img-wrap">
              <image class="point-img" src="{{item.image}}" mode="aspectFit" lazy-load="true"></image>
            </view>
            <view class="point-info">
              <view class="point-title">{{item.title}}</view>
              <view class="point-price">{{item.points}}</view>
            </view>
          </view>
        </swiper-item>
      </swiper>
    </view>

    <view class="recommend-section">
      <view class="recommend-head">
        <view class="recommend-title-group">
          <view class="section-title">精品推荐</view>
          <view class="recommend-sub">正品保障｜售后无忧｜分期免息</view>
        </view>
        <view class="section-more" data-url="/pages/jingcheng/showcase/list" bindtap="goQuick">全部 <text class="iconfont icon-ic_rightarrow"></text></view>
      </view>
      <scroll-view class="product-scroll" scroll-x="true" show-scrollbar="false">
        <view class="product-row">
          <view wx:for="{{products}}" wx:key="id" class="product-card" data-id="{{item.id}}" bindtap="openProduct">
            <view class="product-img-wrap">
              <image class="product-img" src="{{item.image}}" mode="aspectFit" lazy-load="true"></image>
            </view>
            <view class="product-name">{{item.title}}</view>
            <view class="product-spec">{{item.spec}}</view>
            <view class="product-bottom">
              <view>
                <view class="product-price">¥{{item.price}}</view>
                <view class="product-sales">已售{{item.sales}}</view>
              </view>
              <view class="cart-plus" data-id="{{item.id}}" catchtap="openProduct"><text class="iconfont icon-ic_increase"></text></view>
            </view>
          </view>
        </view>
      </scroll-view>
      <view wx:if="{{!products.length && !loading}}" class="empty-tip">暂无推荐商品</view>
    </view>
  </view>

  <view class="home-tabbar">
    <view class="tab-item active" hover-class="tab-pressed" hover-stay-time="120">
      <view class="tab-icon"><text class="iconfont icon-shouye"></text></view>
      <view class="tab-text">首页</view>
      <view class="tab-active-dot"></view>
    </view>
    <view class="tab-item" bindtap="goCategory" hover-class="tab-pressed" hover-stay-time="120">
      <view class="tab-icon"><text class="iconfont icon-fenlei"></text></view>
      <view class="tab-text">分类</view>
    </view>
    <view class="tab-item" bindtap="goPointsMall" hover-class="tab-pressed" hover-stay-time="120">
      <view class="tab-icon"><text class="iconfont icon-jifenshangcheng"></text></view>
      <view class="tab-text">积分商城</view>
    </view>
    <view class="tab-item" bindtap="goMine" hover-class="tab-pressed" hover-stay-time="120">
      <view class="tab-icon"><text class="iconfont icon-geren"></text></view>
      <view class="tab-text">我的</view>
    </view>
  </view>
</view>
