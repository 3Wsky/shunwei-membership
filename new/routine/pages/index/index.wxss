page {
  background: #FAF7F2;
  color: #222222;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", Arial, sans-serif;
}

.home-page {
  min-height: 100vh;
  background: radial-gradient(circle at 72% 0%, rgba(255, 233, 205, 0.62), rgba(255, 249, 243, 0) 36%), linear-gradient(180deg, #FFF9F3 0%, #FAF7F2 46%, #F7F1E8 100%);
  padding-bottom: calc(130rpx + env(safe-area-inset-bottom));
}

.top-shell {
  display: flex;
  align-items: center;
  padding-left: 34rpx;
  padding-bottom: 26rpx;
  box-sizing: border-box;
}

.brand-block {
  flex: 0 0 auto;
}

.brand-name {
  font-size: 36rpx;
  line-height: 44rpx;
  font-weight: 700;
  color: #222222;
}

.brand-subtitle {
  margin-top: 4rpx;
  font-size: 21rpx;
  color: #6E6257;
  letter-spacing: 7rpx;
}

.search-pill {
  min-width: 0;
  flex: 1;
  height: 64rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.88);
  border: 1rpx solid rgba(169, 143, 116, 0.24);
  display: flex;
  align-items: center;
  margin-left: 28rpx;
  padding: 0 24rpx;
  color: #9A948D;
  font-size: 24rpx;
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.66), 0 8rpx 24rpx rgba(120, 80, 40, 0.04);
}

.search-mark {
  width: 20rpx;
  height: 20rpx;
  border: 3rpx solid #C98A45;
  border-radius: 50%;
  margin-right: 14rpx;
  position: relative;
  flex: 0 0 auto;
}

.search-mark::after {
  content: "";
  position: absolute;
  width: 10rpx;
  height: 3rpx;
  right: -8rpx;
  bottom: -4rpx;
  background: #C98A45;
  transform: rotate(45deg);
  border-radius: 10rpx;
}

.home-content {
  padding: 0 34rpx;
}

.card {
  border-radius: 26rpx;
  box-shadow: 0 10rpx 30rpx rgba(120, 80, 40, 0.08);
}

.banner-swiper {
  height: 308rpx;
}

.banner-card {
  height: 288rpx;
  border-radius: 28rpx;
  overflow: hidden;
  background: linear-gradient(135deg, #FBF0E3 0%, #FFF7EF 40%, #F1C894 100%);
  position: relative;
  display: flex;
  box-shadow: 0 12rpx 34rpx rgba(173, 112, 44, 0.12);
}

.banner-card::before {
  content: "";
  position: absolute;
  width: 410rpx;
  height: 410rpx;
  right: 40rpx;
  top: -178rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.92), rgba(255, 255, 255, 0.18) 58%, rgba(255, 255, 255, 0));
}

.banner-card::after {
  content: "";
  position: absolute;
  left: 344rpx;
  bottom: -28rpx;
  width: 390rpx;
  height: 92rpx;
  border-radius: 999rpx;
  border: 20rpx solid rgba(204, 141, 70, 0.18);
  transform: rotate(-18deg);
}

.banner-copy {
  position: relative;
  z-index: 2;
  width: 360rpx;
  padding: 48rpx 0 0 36rpx;
  box-sizing: border-box;
}

.banner-kicker {
  display: none;
  font-size: 20rpx;
  color: #A37336;
  letter-spacing: 0;
  margin-bottom: 10rpx;
}

.banner-title {
  font-size: 42rpx;
  line-height: 52rpx;
  font-weight: 800;
  color: #2B2118;
}

.banner-subtitle {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #7B6045;
}

.banner-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin-top: 26rpx;
  height: 54rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  color: #684018;
  font-size: 24rpx;
  font-weight: 600;
  background: rgba(255, 255, 255, 0.68);
  border: 1rpx solid rgba(153, 92, 39, 0.32);
}

.gift-stage {
  flex: 1;
  position: relative;
  z-index: 2;
}

.gift-halo {
  position: absolute;
  right: 24rpx;
  top: 48rpx;
  width: 260rpx;
  height: 200rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.7), rgba(255, 255, 255, 0));
}

.gift-img {
  position: absolute;
  width: 128rpx;
  height: 128rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.42);
  filter: drop-shadow(0 10rpx 18rpx rgba(101, 64, 29, 0.16));
}

.gift-img-0 {
  right: 154rpx;
  top: 90rpx;
  width: 138rpx;
  height: 138rpx;
}

.gift-img-1 {
  right: 92rpx;
  top: 80rpx;
}

.gift-img-2 {
  right: 16rpx;
  top: 78rpx;
  width: 150rpx;
  height: 150rpx;
}

.gift-img-3 {
  right: 84rpx;
  top: 158rpx;
  width: 112rpx;
  height: 112rpx;
}

.gift-box,
.gift-pad {
  position: absolute;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.5);
}

.gift-box.large {
  right: 72rpx;
  top: 72rpx;
  width: 146rpx;
  height: 146rpx;
}

.gift-box.small {
  right: 18rpx;
  top: 160rpx;
  width: 112rpx;
  height: 112rpx;
}

.gift-pad {
  right: 150rpx;
  top: 190rpx;
  width: 94rpx;
  height: 66rpx;
}

.banner-dots {
  height: 24rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 10rpx;
  margin-top: -16rpx;
  position: relative;
  z-index: 3;
}

.dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #D8D0C8;
}

.dot.active {
  width: 28rpx;
  border-radius: 999rpx;
  background: #FF6A2A;
}

.member-card {
  margin-top: 20rpx;
  padding: 30rpx 32rpx 116rpx;
  background: radial-gradient(circle at 92% 78%, rgba(231, 191, 128, 0.24), rgba(255, 250, 244, 0) 28%), linear-gradient(135deg, #FFF5EA 0%, #FFE8CF 50%, #FFF7ED 100%);
  color: #2A241F;
  position: relative;
  overflow: hidden;
  border: 1rpx solid rgba(255, 255, 255, 0.78);
}

.member-watermark {
  position: absolute;
  border-radius: 50%;
  border: 16rpx solid rgba(210, 154, 82, 0.1);
  background: rgba(255, 255, 255, 0.08);
}

.member-watermark.one {
  width: 230rpx;
  height: 230rpx;
  right: -54rpx;
  bottom: -96rpx;
}

.member-watermark.two {
  width: 116rpx;
  height: 116rpx;
  right: 42rpx;
  bottom: -26rpx;
}

.member-main {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
}

.member-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.78);
  background: #FFF9F3;
  box-shadow: 0 8rpx 18rpx rgba(89, 62, 36, 0.1);
}

.member-info {
  min-width: 0;
  flex: 1;
  margin-left: 20rpx;
}

.member-name-row {
  display: flex;
  align-items: center;
  min-width: 0;
}

.member-name {
  max-width: 170rpx;
  font-size: 34rpx;
  font-weight: 700;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.member-level {
  margin-left: 14rpx;
  padding: 5rpx 14rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #FFF2C8, #FFE1A5);
  color: #9A6728;
  font-size: 20rpx;
  font-weight: 700;
  border: 1rpx solid rgba(185, 126, 54, 0.18);
}

.member-phone {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #766A60;
}

.member-link {
  margin-left: 20rpx;
  font-size: 24rpx;
  color: #9E6D34;
}

.metric {
  width: 118rpx;
  text-align: center;
}

.metric-value {
  font-size: 38rpx;
  line-height: 44rpx;
  font-weight: 800;
  color: #2A241F;
}

.metric-label {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #7D7065;
}

.metric-divider {
  width: 1rpx;
  height: 58rpx;
  margin: 0 18rpx;
  background: rgba(162, 111, 56, 0.16);
}

.member-progress {
  position: relative;
  z-index: 2;
  margin-top: 30rpx;
  height: 64rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: rgba(255, 224, 183, 0.62);
  display: flex;
  align-items: center;
}

.progress-text {
  flex: 0 0 auto;
  font-size: 23rpx;
  color: #8F612E;
}

.progress-track {
  flex: 1;
  margin: 0 18rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: rgba(184, 128, 58, 0.18);
  overflow: hidden;
}

.progress-fill {
  width: 68%;
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #C98A45, #E8B66A);
}

.quick-card {
  margin-top: -78rpx;
  height: 156rpx;
  background: rgba(255, 255, 255, 0.96);
  display: flex;
  align-items: center;
  justify-content: space-around;
  position: relative;
  z-index: 4;
  border: 1rpx solid rgba(255, 255, 255, 0.86);
}

.quick-item {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.quick-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 700;
}

.quick-icon.mint {
  color: #269B76;
  background: #E8F7EF;
}

.quick-icon.blue {
  color: #3478B9;
  background: #EAF3FF;
}

.quick-icon.gold {
  color: #B77B2D;
  background: #FFF3D8;
}

.quick-icon.orange {
  color: #FF6A2A;
  background: #FFF0E8;
}

.quick-title {
  margin-top: 11rpx;
  font-size: 24rpx;
  color: #3E342B;
}

.notice-card {
  margin-top: 16rpx;
  height: 76rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.9);
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(120, 80, 40, 0.07);
}

.notice-icon {
  width: 46rpx;
  height: 46rpx;
  border-radius: 50%;
  background: #FFF0E8;
  color: #FF6A2A;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 700;
  margin-right: 16rpx;
}

.notice-text {
  flex: 1;
  min-width: 0;
  font-size: 25rpx;
  color: #4A3B2D;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.notice-arrow {
  color: #B8A28C;
  font-size: 28rpx;
  margin-left: 12rpx;
}

.signin-card {
  margin-top: 16rpx;
  padding: 22rpx 24rpx 20rpx;
  background: #FFFFFF;
}

.signin-top {
  min-height: 112rpx;
  border-radius: 22rpx;
  background: transparent;
  display: flex;
  align-items: center;
  padding: 0;
  box-sizing: border-box;
}

.signin-illustration {
  width: 132rpx;
  height: 112rpx;
  position: relative;
  flex: 0 0 auto;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #FFF5E7, #FFE2B8);
}

.box-lid {
  position: absolute;
  left: 34rpx;
  top: 18rpx;
  width: 64rpx;
  height: 24rpx;
  border-radius: 12rpx 12rpx 4rpx 4rpx;
  background: linear-gradient(90deg, #F3C177, #D89438);
  transform: rotate(-8deg);
}

.box-body {
  position: absolute;
  left: 38rpx;
  top: 42rpx;
  width: 58rpx;
  height: 54rpx;
  border-radius: 10rpx 10rpx 16rpx 16rpx;
  background: linear-gradient(180deg, #FFFFFF, #F5C984);
  box-shadow: 0 10rpx 18rpx rgba(174, 110, 39, 0.16);
}

.signin-copy {
  flex: 1;
  min-width: 0;
  margin-left: 22rpx;
}

.section-title {
  font-size: 32rpx;
  line-height: 40rpx;
  font-weight: 800;
  color: #222222;
}

.section-title.compact {
  font-size: 32rpx;
}

.section-subtitle,
.recommend-sub {
  margin-top: 6rpx;
  font-size: 23rpx;
  color: #888888;
}

.score-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin-left: 10rpx;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(255, 106, 42, 0.12);
  color: #FF6A2A;
  font-size: 22rpx;
}

.signin-button {
  height: 60rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #FF7A35, #FF6A2A);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 700;
}

.signin-days {
  display: flex;
  justify-content: space-between;
  margin-top: 18rpx;
}

.day-card {
  position: relative;
  flex: 1;
  min-width: 0;
  height: 78rpx;
  margin-right: 10rpx;
  border: 1rpx solid #E9D9C8;
  border-radius: 16rpx;
  background: #FFFFFF;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #B29A82;
}

.day-card:last-child {
  margin-right: 0;
}

.day-card.checked {
  border-color: rgba(255, 106, 42, 0.24);
  background: linear-gradient(180deg, #FFF2E4, #FFE5CB);
  color: #FF6A2A;
}

.day-card.gift {
  background: linear-gradient(180deg, #FFF8EF, #FFE7D7);
}

.day-check {
  position: absolute;
  right: 8rpx;
  bottom: 8rpx;
  width: 26rpx;
  height: 26rpx;
  border-radius: 50%;
  background: #E8B66A;
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18rpx;
  font-weight: 800;
}

.day-gift {
  margin-top: 2rpx;
  font-size: 24rpx;
  font-weight: 800;
  color: #FF6A2A;
}

.day-name {
  margin-top: 4rpx;
  font-size: 20rpx;
  line-height: 24rpx;
}

.day-reward {
  margin-top: 0;
  font-size: 21rpx;
  font-weight: 700;
}

.points-section {
  margin-top: 16rpx;
  padding: 24rpx 0 22rpx;
  background: #FFFFFF;
}

.section-head,
.recommend-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
}

.section-more {
  font-size: 24rpx;
  color: #C98A45;
}

.points-scroll {
  margin-top: 18rpx;
  white-space: nowrap;
}

.points-row {
  display: inline-flex;
  padding: 0 24rpx;
}

.point-good {
  width: 198rpx;
  height: 136rpx;
  margin-right: 14rpx;
  border-radius: 18rpx;
  background: #FFFDF9;
  box-shadow: inset 0 0 0 1rpx rgba(230, 206, 178, 0.44);
  padding: 0;
  box-sizing: border-box;
  position: relative;
  overflow: hidden;
}

.point-img-wrap {
  height: 136rpx;
  border-radius: 18rpx;
  background: #F8F5F0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.point-img {
  width: 198rpx;
  height: 136rpx;
}

.point-info {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  min-height: 46rpx;
  padding: 8rpx 10rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0), rgba(255, 250, 245, 0.96));
}

.point-title {
  margin-top: 0;
  height: 28rpx;
  font-size: 20rpx;
  line-height: 28rpx;
  color: #333333;
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  white-space: normal;
}

.point-price {
  display: inline-flex;
  position: absolute;
  right: 8rpx;
  bottom: 8rpx;
  margin-top: 0;
  max-width: 100%;
  padding: 7rpx 12rpx;
  border-radius: 999rpx;
  background: #FFF0D8;
  color: #B77B2D;
  font-size: 21rpx;
  font-weight: 700;
}

.recommend-section {
  margin-top: 16rpx;
  padding: 24rpx 0 22rpx;
  border-radius: 26rpx;
  background: #FFFFFF;
  box-shadow: 0 10rpx 30rpx rgba(120, 80, 40, 0.08);
}

.recommend-head {
  padding: 0 24rpx 18rpx;
}

.product-scroll {
  white-space: nowrap;
}

.product-row {
  display: inline-flex;
  padding: 0 24rpx;
}

.product-card {
  width: 146rpx;
  min-width: 0;
  border-radius: 16rpx;
  background: #FFFFFF;
  box-shadow: inset 0 0 0 1rpx rgba(224, 211, 197, 0.72);
  overflow: hidden;
  padding-bottom: 12rpx;
  margin-right: 14rpx;
}

.product-img-wrap {
  height: 150rpx;
  background: linear-gradient(180deg, #FFFFFF, #F7F5F1);
  display: flex;
  align-items: center;
  justify-content: center;
}

.product-img {
  width: 132rpx;
  height: 132rpx;
}

.product-name {
  margin: 12rpx 12rpx 0;
  min-height: 60rpx;
  font-size: 22rpx;
  line-height: 30rpx;
  color: #27221E;
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.product-spec {
  margin: 4rpx 12rpx 0;
  height: 28rpx;
  font-size: 20rpx;
  color: #91877E;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.product-bottom {
  margin: 8rpx 12rpx 0;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
}

.product-price {
  font-size: 25rpx;
  line-height: 30rpx;
  color: #FF6A2A;
  font-weight: 800;
}

.product-sales {
  margin-top: 4rpx;
  font-size: 19rpx;
  color: #999999;
}

.cart-plus {
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FF7A35, #FF6A2A);
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  line-height: 32rpx;
  box-shadow: 0 8rpx 18rpx rgba(255, 106, 42, 0.26);
}

.empty-tip {
  height: 120rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #9B948C;
  font-size: 26rpx;
}

.home-tabbar {
  position: fixed;
  left: 34rpx;
  right: 34rpx;
  bottom: 12rpx;
  padding: 14rpx 0 calc(14rpx + env(safe-area-inset-bottom));
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 -8rpx 28rpx rgba(82, 55, 28, 0.09);
  display: flex;
  z-index: 20;
  border: 1rpx solid rgba(236, 226, 214, 0.7);
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #96928E;
  font-size: 21rpx;
}

.tab-icon {
  width: 44rpx;
  height: 42rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 21rpx;
  font-weight: 700;
  background: transparent;
}

.tab-text {
  margin-top: 6rpx;
}

.tab-item.active {
  color: #FF6A2A;
}

.tab-item.active .tab-icon {
  color: #FFFFFF;
  background: #FF6A2A;
}
