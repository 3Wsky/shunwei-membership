page {
  background: #F4F5F7;
  color: #222222;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", Arial, sans-serif;
}

.home-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #FFF8F0 0, #F6F7F8 520rpx, #F4F5F7 100%);
  padding-bottom: calc(154rpx + env(safe-area-inset-bottom));
}

.top-shell {
  display: flex;
  align-items: center;
  padding-left: 34rpx;
  padding-bottom: 24rpx;
  box-sizing: border-box;
}

.brand-block {
  flex: 0 0 auto;
}

.brand-name {
  font-size: 35rpx;
  line-height: 44rpx;
  font-weight: 800;
  color: #222222;
  letter-spacing: 1rpx;
}

.brand-subtitle {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #6E6257;
  letter-spacing: 6rpx;
}

.search-pill {
  min-width: 0;
  flex: 1;
  height: 66rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.88);
  border: 1rpx solid rgba(169, 143, 116, 0.24);
  display: flex;
  align-items: center;
  margin-left: 24rpx;
  padding: 0 22rpx;
  color: #9A948D;
  font-size: 23rpx;
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.66), 0 8rpx 24rpx rgba(120, 80, 40, 0.04);
}

.search-icon {
  flex: 0 0 auto;
  margin-right: 12rpx;
  color: #B58A61;
  font-size: 29rpx;
}

.search-placeholder {
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.home-content {
  padding: 0 24rpx;
}

.card {
  border-radius: 16rpx;
  box-shadow: 0 8rpx 24rpx rgba(34, 28, 23, 0.07);
}

.tap-feedback {
  opacity: 0.86;
  transform: scale(0.985);
}

.banner-swiper {
  height: 308rpx;
}

.banner-card {
  height: 288rpx;
  border-radius: 18rpx;
  overflow: hidden;
  background: linear-gradient(135deg, #FBF0E3 0%, #FFF7EF 40%, #F1C894 100%);
  position: relative;
  display: flex;
  box-shadow: 0 12rpx 34rpx rgba(173, 112, 44, 0.12);
  border: 1rpx solid rgba(255, 255, 255, 0.72);
}

.banner-card::before {
  content: "";
  position: absolute;
  width: 410rpx;
  height: 410rpx;
  right: 40rpx;
  top: -178rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.92), rgba(255, 255, 255, 0.18) 58%, rgba(255, 255, 255, 0));
}

.banner-card::after {
  content: "";
  position: absolute;
  left: 344rpx;
  bottom: -28rpx;
  width: 390rpx;
  height: 92rpx;
  border-radius: 999rpx;
  border: 20rpx solid rgba(204, 141, 70, 0.18);
  transform: rotate(-18deg);
}

.banner-card.has-image::before,
.banner-card.has-image::after {
  display: none;
}

.banner-background,
.banner-image-shade {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.banner-background {
  z-index: 0;
}

.banner-image-shade {
  z-index: 1;
  background: linear-gradient(90deg, rgba(255, 250, 244, 0.97) 0%, rgba(255, 250, 244, 0.82) 36%, rgba(255, 250, 244, 0.08) 72%);
}

.banner-copy {
  position: absolute;
  z-index: 2;
  top: 0;
  bottom: 0;
  left: 36rpx;
  display: flex;
  width: 326rpx;
  padding: 20rpx 0;
  box-sizing: border-box;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
}

.banner-kicker {
  display: none;
  font-size: 20rpx;
  color: #A37336;
  letter-spacing: 0;
  margin-bottom: 10rpx;
}

.banner-title {
  font-size: 42rpx;
  line-height: 52rpx;
  font-weight: 800;
  color: #2B2118;
  display: -webkit-box;
  width: 100%;
  max-height: 104rpx;
  overflow: hidden;
  word-break: break-all;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.banner-subtitle {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 34rpx;
  color: #7B6045;
  display: -webkit-box;
  width: 100%;
  max-height: 68rpx;
  overflow: hidden;
  word-break: break-all;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.banner-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  max-width: 100%;
  margin-top: 16rpx;
  height: 50rpx;
  padding: 0 18rpx 0 22rpx;
  border-radius: 999rpx;
  color: #684018;
  font-size: 24rpx;
  font-weight: 600;
  background: rgba(255, 255, 255, 0.68);
  border: 1rpx solid rgba(153, 92, 39, 0.32);
  overflow: hidden;
  white-space: nowrap;
}

.banner-copy.compact .banner-title {
  font-size: 36rpx;
  line-height: 44rpx;
  max-height: 88rpx;
}

.banner-copy.compact .banner-subtitle {
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 30rpx;
  max-height: 60rpx;
}

.banner-copy.compact .banner-button {
  margin-top: 12rpx;
  height: 46rpx;
  font-size: 22rpx;
}

.banner-copy.dense .banner-title {
  font-size: 32rpx;
  line-height: 39rpx;
  max-height: 78rpx;
}

.banner-copy.dense .banner-subtitle {
  margin-top: 6rpx;
  font-size: 20rpx;
  line-height: 27rpx;
  max-height: 54rpx;
}

.banner-copy.dense .banner-button {
  margin-top: 10rpx;
  height: 42rpx;
  padding: 0 15rpx 0 18rpx;
  font-size: 20rpx;
}

.banner-button-arrow {
  margin-left: 8rpx;
  font-size: 22rpx;
}

.gift-stage {
  flex: 1;
  position: relative;
  z-index: 2;
}

.gift-halo {
  position: absolute;
  right: 24rpx;
  top: 48rpx;
  width: 260rpx;
  height: 200rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.7), rgba(255, 255, 255, 0));
}

.gift-base {
  position: absolute;
  right: 12rpx;
  bottom: 32rpx;
  width: 278rpx;
  height: 48rpx;
  border-radius: 50%;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.76), rgba(205, 143, 75, 0.2));
  box-shadow: 0 16rpx 26rpx rgba(122, 79, 36, 0.13);
}

.gift-spark {
  position: absolute;
  z-index: 3;
  width: 10rpx;
  height: 10rpx;
  background: #E6B86F;
  transform: rotate(45deg);
  box-shadow: 0 0 12rpx rgba(224, 163, 79, 0.45);
}

.spark-one {
  right: 214rpx;
  top: 56rpx;
}

.spark-two {
  right: 36rpx;
  top: 44rpx;
  width: 7rpx;
  height: 7rpx;
}

.gift-img {
  position: absolute;
  width: 128rpx;
  height: 128rpx;
  border-radius: 18rpx;
  background: transparent;
  filter: drop-shadow(0 10rpx 18rpx rgba(101, 64, 29, 0.16));
}

.gift-img-0 {
  right: 154rpx;
  top: 88rpx;
  width: 138rpx;
  height: 138rpx;
}

.gift-img-1 {
  right: 92rpx;
  top: 76rpx;
}

.gift-img-2 {
  right: 16rpx;
  top: 76rpx;
  width: 150rpx;
  height: 150rpx;
}

.gift-img-3 {
  right: 84rpx;
  top: 154rpx;
  width: 112rpx;
  height: 112rpx;
}

.gift-box,
.gift-pad {
  position: absolute;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.5);
}

.gift-box.large {
  right: 72rpx;
  top: 72rpx;
  width: 146rpx;
  height: 146rpx;
}

.gift-box.small {
  right: 18rpx;
  top: 160rpx;
  width: 112rpx;
  height: 112rpx;
}

.gift-pad {
  right: 150rpx;
  top: 190rpx;
  width: 94rpx;
  height: 66rpx;
}

.banner-dots {
  height: 24rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 10rpx;
  margin-top: -16rpx;
  position: relative;
  z-index: 3;
}

.dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #D8D0C8;
}

.dot.active {
  width: 28rpx;
  border-radius: 999rpx;
  background: #FF6A2A;
}

.member-card {
  margin-top: 20rpx;
  height: 216rpx;
  border-radius: 22rpx;
  padding: 24rpx 24rpx 16rpx;
  box-sizing: border-box;
  background-color: #FBF1E5;
  background-image: url('/static/images/home/member-card-bg-v2.jpg');
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
  color: #2A2521;
  position: relative;
  overflow: hidden;
  border: 1rpx solid rgba(190, 145, 96, 0.12);
  box-shadow: 0 8rpx 24rpx rgba(116, 83, 50, 0.09), inset 0 1rpx 0 rgba(255, 255, 255, 0.94);
}

.member-card::before {
  display: none;
}

.member-watermark {
  display: none;
}

.member-watermark.one {
  width: 148rpx;
  height: 148rpx;
  right: -6rpx;
  bottom: -68rpx;
}

.member-watermark.two {
  width: 104rpx;
  height: 104rpx;
  right: 16rpx;
  bottom: -46rpx;
}

.member-main {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8rpx;
}

.member-identity {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
}

.member-avatar {
  width: 84rpx;
  height: 84rpx;
  flex: 0 0 auto;
  border-radius: 50%;
  border: 3rpx solid rgba(255, 255, 255, 0.98);
  background: #F4F1ED;
  box-shadow: 0 0 0 1rpx rgba(176, 127, 76, 0.18), 0 8rpx 18rpx rgba(82, 57, 34, 0.12);
}

.member-info {
  min-width: 0;
  flex: 1;
  margin-left: 12rpx;
}

.member-name-row {
  display: flex;
  align-items: center;
  min-width: 0;
  gap: 6rpx;
}

.member-name {
  max-width: 118rpx;
  flex: 0 1 auto;
  font-size: 29rpx;
  line-height: 36rpx;
  font-weight: 700;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.member-level {
  flex: 0 0 auto;
  padding: 2rpx 7rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #F8E7D0, #F3D5AE);
  color: #9A682C;
  font-size: 16rpx;
  line-height: 22rpx;
  font-weight: 700;
  border: 1rpx solid rgba(186, 128, 62, 0.2);
  display: flex;
  align-items: center;
  white-space: nowrap;
}

.member-level-vip {
  margin-right: 4rpx;
  color: #AD742F;
  font-size: 16rpx;
  font-style: italic;
  font-weight: 800;
}

.member-phone {
  margin-top: 5rpx;
  font-size: 18rpx;
  line-height: 22rpx;
  color: #81766C;
}

.member-link {
  margin-left: 12rpx;
  font-size: 17rpx;
  color: #9A672F;
  white-space: nowrap;
}

.member-link .iconfont {
  font-size: 15rpx;
}

.member-metrics {
  flex: 0 0 258rpx;
  min-width: 0;
  display: flex;
  align-items: center;
}

.metric {
  flex: 1;
  min-width: 0;
  text-align: center;
}

.metric-value {
  font-size: 28rpx;
  line-height: 36rpx;
  font-weight: 700;
  color: #27211C;
  white-space: nowrap;
}

.metric-value.compact {
  font-size: 24rpx;
}

.metric-currency {
  margin-right: 2rpx;
  color: #4B4037;
  font-size: 23rpx;
  line-height: 36rpx;
  font-weight: 700;
}

.voucher-metric .metric-value {
  color: #27211C;
}

.metric-label {
  margin-top: 3rpx;
  font-size: 17rpx;
  color: #817469;
  white-space: nowrap;
}

.metric-divider {
  display: none;
}

.member-progress {
  position: relative;
  z-index: 2;
  width: calc(100% - 60rpx);
  margin-top: 16rpx;
  height: 46rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.48);
  border: 0;
  box-sizing: border-box;
  display: flex;
  align-items: center;
}

.progress-text {
  flex: 0 0 auto;
  font-size: 15rpx;
  color: #76685C;
}

.progress-track {
  flex: 1;
  margin: 0 12rpx;
  height: 5rpx;
  border-radius: 999rpx;
  background: rgba(161, 111, 59, 0.14);
  overflow: hidden;
}

.progress-fill {
  width: 68%;
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #C98A45, #E8B66A);
}

.quick-card {
  margin-top: -28rpx;
  height: 124rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.98);
  display: flex;
  align-items: center;
  justify-content: flex-start;
  padding-left: 5rpx;
  box-sizing: border-box;
  position: relative;
  z-index: 4;
  border: 1rpx solid rgba(232, 225, 218, 0.66);
  box-shadow: 0 8rpx 22rpx rgba(70, 57, 45, 0.08);
}

.quick-item {
  width: 162rpx;
  flex: 0 0 162rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  transition: opacity 160ms ease, transform 160ms ease;
}

.quick-item-pressed {
  opacity: 0.72;
  transform: scale(0.94);
}

.quick-icon {
  width: 66rpx;
  height: 66rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 700;
  position: relative;
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.64);
}

.quick-icon::after {
  content: "";
  position: absolute;
  top: 10rpx;
  left: 16rpx;
  width: 20rpx;
  height: 8rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.58);
}

.quick-icon.mint {
  color: #269B76;
  background: #E8F7EF;
}

.quick-icon.blue {
  color: #3478B9;
  background: #EAF3FF;
}

.quick-icon.gold {
  color: #B77B2D;
  background: #FFF3D8;
}

.quick-icon.orange {
  color: #FF6A2A;
  background: #FFF0E8;
}

.quick-title {
  margin-top: 7rpx;
  font-size: 18rpx;
  color: #3E342B;
}

.notice-card {
  margin-top: 12rpx;
  height: 48rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.96);
  display: flex;
  align-items: center;
  padding: 0 16rpx;
  box-shadow: 0 4rpx 14rpx rgba(80, 63, 47, 0.06);
}

.notice-icon {
  width: 28rpx;
  height: 32rpx;
  color: #FF6A2A;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  margin-right: 2rpx;
}

.notice-label {
  flex: 0 0 auto;
  padding-right: 10rpx;
  margin-right: 10rpx;
  border-right: 1rpx solid #EEE3D8;
  color: #FF6A2A;
  font-size: 17rpx;
  font-weight: 700;
}

.notice-text {
  flex: 1;
  min-width: 0;
  font-size: 17rpx;
  color: #4A3B2D;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.notice-arrow {
  color: #B8A28C;
  font-size: 18rpx;
  margin-left: 8rpx;
}

.signin-card {
  margin-top: 12rpx;
  height: 144rpx;
  padding: 12rpx 18rpx;
  box-sizing: border-box;
  border-radius: 20rpx;
  background: #FFFFFF;
  border: 1rpx solid rgba(34, 28, 23, 0.05);
  position: relative;
}

.signin-top {
  min-height: 58rpx;
  height: 58rpx;
  background: transparent;
  display: flex;
  align-items: center;
  padding: 0;
  box-sizing: border-box;
}

.signin-illustration {
  width: 150rpx;
  height: 132rpx;
  position: absolute;
  left: 0;
  top: 0;
  flex: 0 0 auto;
  border-radius: 0;
  background: transparent;
  overflow: visible;
}

.signin-glow {
  display: none;
}

.signin-gift-img {
  position: absolute;
  left: 0;
  top: -8rpx;
  width: 150rpx;
  height: 150rpx;
  filter: drop-shadow(0 8rpx 12rpx rgba(178, 110, 35, 0.14));
}

.signin-copy {
  flex: 1;
  min-width: 0;
  margin-left: 144rpx;
}

.section-title {
  font-size: 32rpx;
  line-height: 40rpx;
  font-weight: 800;
  color: #222222;
}

.section-title.compact {
  font-size: 25rpx;
  line-height: 31rpx;
}

.section-subtitle,
.recommend-sub {
  margin-top: 2rpx;
  font-size: 17rpx;
  color: #888888;
}

.score-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin-left: 6rpx;
  padding: 2rpx 7rpx;
  border-radius: 999rpx;
  background: rgba(255, 106, 42, 0.12);
  color: #FF6A2A;
  font-size: 15rpx;
}

.signin-button {
  height: 44rpx;
  min-width: 120rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #FF7A35, #FF6A2A);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  font-size: 18rpx;
  font-weight: 700;
  box-shadow: 0 8rpx 18rpx rgba(255, 106, 42, 0.2);
  transition: opacity 160ms ease, transform 160ms ease;
}

.signin-button-pressed {
  opacity: 0.86;
  transform: scale(0.96);
}

.signin-days {
  display: flex;
  justify-content: space-between;
  height: 54rpx;
  margin-top: 4rpx;
  margin-left: 144rpx;
}

.day-card {
  position: relative;
  flex: 1;
  min-width: 0;
  height: 54rpx;
  margin-right: 2rpx;
  border: 0;
  border-radius: 8rpx;
  background: transparent;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #B29A82;
}

.day-card:last-child {
  margin-right: 0;
}

.day-card.checked {
  background: transparent;
  color: #FF6A2A;
}

.day-card.current {
  background: linear-gradient(180deg, #FFF0DE, #FFE4C8);
}

.day-card.gift {
  background: linear-gradient(180deg, #FFF8EF, #FFE7D7);
  border: 0;
}

.day-check {
  position: absolute;
  right: 3rpx;
  bottom: 2rpx;
  top: auto;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #E8B66A;
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 9rpx;
  font-weight: 800;
}

.day-gift {
  margin-top: -2rpx;
  font-size: 14rpx;
  font-weight: 800;
  color: #FF6A2A;
}

.day-name {
  margin-top: 0;
  font-size: 13rpx;
  line-height: 16rpx;
}

.day-reward {
  margin-top: 0;
  font-size: 13rpx;
  font-weight: 700;
}

.points-section {
  margin-top: 16rpx;
  padding: 24rpx 0 20rpx;
  background: transparent;
  box-shadow: none;
}

.section-head,
.recommend-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
}

.section-more {
  font-size: 24rpx;
  color: #C98A45;
  display: flex;
  align-items: center;
  white-space: nowrap;
  transition: opacity 160ms ease;
}

.link-pressed {
  opacity: 0.58;
}

.section-more .iconfont {
  margin-left: 4rpx;
  font-size: 21rpx;
}

.points-swiper {
  margin-top: 16rpx;
  width: 100%;
  height: 430rpx;
}

.point-slide {
  padding: 0 24rpx 8rpx;
  box-sizing: border-box;
}

.points-pair {
  height: 100%;
  display: flex;
  gap: 14rpx;
}

.point-good {
  width: 0;
  height: 412rpx;
  flex: 1;
  border-radius: 16rpx;
  background: #FFFFFF;
  box-shadow: inset 0 0 0 1rpx rgba(225, 218, 211, 0.72), 0 10rpx 24rpx rgba(64, 51, 39, 0.08);
  padding: 10rpx;
  box-sizing: border-box;
  position: relative;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  transition: transform 180ms ease, box-shadow 180ms ease;
}

.point-good::before {
  display: none;
}

.point-good-pressed {
  transform: scale(0.985);
  box-shadow: inset 0 0 0 1rpx rgba(225, 218, 211, 0.8), 0 6rpx 16rpx rgba(64, 51, 39, 0.07);
}

.point-img-wrap {
  width: 100%;
  height: 300rpx;
  flex: 0 0 auto;
  border-radius: 12rpx;
  background: #F7F7F6;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  z-index: 1;
  box-shadow: none;
  overflow: hidden;
}

.point-img {
  width: 100%;
  height: 100%;
  display: block;
}

.point-info {
  width: 100%;
  flex: 1;
  min-width: 0;
  margin-left: 0;
  padding: 10rpx 6rpx 4rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  position: relative;
  z-index: 1;
  background: transparent;
}

.point-title {
  margin-top: 0;
  width: 100%;
  min-height: 30rpx;
  max-height: 30rpx;
  font-size: 22rpx;
  line-height: 30rpx;
  color: #2E251D;
  font-weight: 700;
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  white-space: normal;
}

.point-price {
  display: inline-flex;
  align-self: flex-start;
  margin-top: 6rpx;
  max-width: 100%;
  min-height: 34rpx;
  padding: 0 12rpx;
  border-radius: 999rpx;
  background: #FFF0D8;
  color: #B06F2B;
  font-size: 21rpx;
  line-height: 34rpx;
  font-weight: 800;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  box-shadow: none;
}

.recommend-section {
  margin-top: 16rpx;
  padding: 24rpx 0 18rpx;
  border-radius: 0;
  background: transparent;
  box-shadow: none;
}

.recommend-head {
  padding: 0 24rpx 18rpx;
}

.recommend-title-group {
  min-width: 0;
  display: flex;
  align-items: baseline;
}

.recommend-title-group .recommend-sub {
  margin: 0 0 0 16rpx;
  font-size: 21rpx;
  white-space: nowrap;
}

.product-grid {
  padding: 0 24rpx 8rpx;
}

.product-row {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 22rpx 20rpx;
}

.product-card {
  width: 100%;
  min-width: 0;
  border-radius: 14rpx;
  background: #FFFFFF;
  box-shadow: 0 16rpx 34rpx rgba(86, 58, 34, 0.11), inset 0 0 0 1rpx rgba(224, 211, 197, 0.62);
  overflow: hidden;
  padding-bottom: 20rpx;
  position: relative;
  transition: transform 180ms ease, box-shadow 180ms ease;
}

.product-card:active {
  transform: scale(0.985);
  box-shadow: 0 10rpx 22rpx rgba(86, 58, 34, 0.09), inset 0 0 0 1rpx rgba(224, 211, 197, 0.76);
}

.product-img-wrap {
  height: 232rpx;
  background: linear-gradient(180deg, #FFFFFF, #F3EEE8);
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 14rpx 14rpx 0 0;
}

.product-img {
  width: 234rpx;
  height: 218rpx;
}

.product-name {
  margin: 20rpx 22rpx 0;
  min-height: 62rpx;
  font-size: 26rpx;
  line-height: 31rpx;
  color: #27221E;
  font-weight: 700;
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.product-desc {
  margin: 8rpx 22rpx 0;
  min-height: 54rpx;
  font-size: 21rpx;
  line-height: 27rpx;
  color: #7A7168;
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.product-tags {
  min-height: 34rpx;
  margin: 12rpx 22rpx 0;
  display: flex;
  flex-wrap: nowrap;
  gap: 8rpx;
  overflow: hidden;
}

.product-tag {
  max-width: 130rpx;
  height: 34rpx;
  padding: 0 10rpx;
  border-radius: 8rpx;
  background: #FFF1E9;
  color: #C45F28;
  font-size: 18rpx;
  line-height: 34rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  box-sizing: border-box;
}

.product-bottom {
  margin: 16rpx 22rpx 0;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 10rpx;
}

.product-price {
  font-size: 36rpx;
  line-height: 42rpx;
  color: #FF6A2A;
  font-weight: 800;
  white-space: nowrap;
}

.product-sku {
  min-width: 0;
  flex: 1;
  text-align: right;
  color: #9B948C;
  font-size: 19rpx;
  line-height: 25rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.empty-tip {
  height: 120rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #9B948C;
  font-size: 26rpx;
}

.home-tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  min-height: 104rpx;
  padding: 8rpx 26rpx calc(8rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  border-radius: 0;
  background: rgba(255, 255, 255, 0.97);
  box-shadow: 0 -8rpx 22rpx rgba(90, 58, 28, 0.08);
  display: flex;
  align-items: center;
  z-index: 20;
  border-top: 1rpx solid rgba(236, 226, 214, 0.7);
  overflow: visible;
}

.home-tabbar::before {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  height: 1rpx;
  background: linear-gradient(90deg, transparent, rgba(207, 155, 94, 0.28), transparent);
}

.tab-item {
  flex: 1;
  height: 92rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #8E857D;
  position: relative;
  transition: transform 180ms ease, color 180ms ease;
}

.tab-item.tab-pressed {
  transform: scale(0.92);
}

.tab-icon {
  width: 48rpx;
  height: 48rpx;
  border-radius: 17rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  font-weight: 700;
  background: transparent;
  transition: transform 240ms ease, background 240ms ease, color 240ms ease, box-shadow 240ms ease;
}

.tab-icon .iconfont {
  font-size: 34rpx;
}

.tab-text {
  margin-top: 1rpx;
  font-size: 20rpx;
  line-height: 28rpx;
  transition: transform 240ms ease, color 240ms ease;
}

.tab-item.active {
  color: #FF6A2A;
}

.tab-item.active .tab-icon {
  color: #FFFFFF;
  background: linear-gradient(135deg, #FF8750, #FF5F2B);
  box-shadow: 0 7rpx 14rpx rgba(255, 106, 42, 0.2);
}

.tab-item.active .tab-text {
  font-weight: 700;
}

.tab-active-dot {
  position: absolute;
  bottom: 0;
  width: 18rpx;
  height: 5rpx;
  border-radius: 3rpx;
  background: #FF6A2A;
}
