page {
  background: #FAF7F2;
  color: #28231F;
}

.category-page { min-height: 100vh; }

.top-shell {
  padding: 20rpx 0 22rpx;
  background: #FFFDF9;
  border-bottom: 1rpx solid #F0E9E1;
}

.search-box {
  height: 76rpx;
  margin: 0 28rpx;
  padding: 0 10rpx 0 24rpx;
  display: flex;
  align-items: center;
  border: 1rpx solid #ECE3DA;
  border-radius: 38rpx;
  background: #FFFFFF;
  box-shadow: 0 7rpx 20rpx rgba(111, 76, 43, 0.055);
}

.search-icon { flex: 0 0 auto; color: #9B8D80; font-size: 29rpx; }
.search-input { min-width: 0; height: 76rpx; flex: 1; margin-left: 14rpx; color: #342C26; font-size: 25rpx; }
.search-clear { width: 46rpx; height: 46rpx; color: #A79B90; font-size: 32rpx; line-height: 42rpx; text-align: center; }
.search-submit { width: 92rpx; height: 56rpx; border-radius: 29rpx; color: #FFFFFF; background: linear-gradient(135deg, #FF8350, #FF602C); font-size: 23rpx; line-height: 56rpx; text-align: center; }

.category-scroll { width: 100%; margin-top: 22rpx; white-space: nowrap; }
.category-track { display: inline-flex; min-width: 100%; padding: 0 24rpx 2rpx; box-sizing: border-box; }
.category-entry { position: relative; min-width: 98rpx; height: 62rpx; margin-right: 10rpx; padding: 0 18rpx; box-sizing: border-box; display: inline-flex; align-items: center; justify-content: center; border: 1rpx solid #EEE6DE; border-radius: 16rpx; color: #7C7066; background: #FFFFFF; box-shadow: 0 5rpx 14rpx rgba(111, 76, 43, 0.035); transition: opacity 150ms ease, transform 150ms ease; }
.category-entry:last-child { margin-right: 0; }
.category-name { max-width: 126rpx; overflow: hidden; font-size: 24rpx; font-weight: 600; line-height: 32rpx; text-overflow: ellipsis; white-space: nowrap; }
.category-entry.active { border-color: #3B3028; color: #FFFFFF; background: #3B3028; box-shadow: 0 8rpx 17rpx rgba(58, 46, 37, 0.18); }
.category-entry.active .category-name { font-weight: 800; }
.entry-pressed { opacity: 0.72; transform: scale(0.97); }

.catalog-head { margin: 26rpx 28rpx 18rpx; display: flex; align-items: flex-end; justify-content: space-between; }
.catalog-title { color: #2B2520; font-size: 36rpx; font-weight: 800; line-height: 46rpx; }
.catalog-subtitle { margin-top: 5rpx; color: #9C8F84; font-size: 21rpx; line-height: 30rpx; }
.catalog-count { min-width: 68rpx; height: 42rpx; padding: 0 13rpx; box-sizing: border-box; border: 1rpx solid #E9DDD1; border-radius: 22rpx; color: #8B7D70; background: #FFFDF9; font-size: 20rpx; line-height: 40rpx; text-align: center; }

.product-grid { padding: 0 22rpx; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18rpx; }
.product-card { min-width: 0; overflow: hidden; border: 1rpx solid #F0E8E0; border-radius: 22rpx; background: #FFFFFF; box-shadow: 0 8rpx 23rpx rgba(107, 73, 39, 0.06); transition: opacity 140ms ease, transform 140ms ease; }
.product-pressed { opacity: 0.82; transform: scale(0.98); }
.product-visual { position: relative; height: 310rpx; margin: 10rpx 10rpx 0; overflow: hidden; border-radius: 17rpx; background: #F8F6F3; }
.product-image { width: 100%; height: 100%; }
.product-placeholder { height: 100%; display: flex; align-items: center; justify-content: center; color: #B19B85; font-size: 25rpx; }
.badge-row { position: absolute; top: 12rpx; left: 12rpx; display: flex; flex-wrap: wrap; gap: 6rpx; }
.product-badge { height: 34rpx; padding: 0 11rpx; border-radius: 18rpx; color: #A56B2D; background: rgba(255, 247, 231, 0.94); box-shadow: 0 3rpx 10rpx rgba(100, 71, 40, 0.07); font-size: 18rpx; line-height: 34rpx; }
.product-content { padding: 15rpx 16rpx 17rpx; }
.product-name { height: 70rpx; overflow: hidden; color: #302923; font-size: 27rpx; font-weight: 700; line-height: 35rpx; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.product-meta { height: 30rpx; margin-top: 8rpx; overflow: hidden; color: #A0958B; font-size: 20rpx; line-height: 30rpx; text-overflow: ellipsis; white-space: nowrap; }
.product-footer { min-height: 54rpx; margin-top: 12rpx; display: flex; align-items: center; justify-content: space-between; }
.product-price { min-width: 0; overflow: hidden; color: #EF5A2B; font-size: 34rpx; font-weight: 900; line-height: 44rpx; text-overflow: ellipsis; white-space: nowrap; }
.product-price .currency { margin-right: 2rpx; font-size: 22rpx; }
.product-price.consult { font-size: 24rpx; }
.detail-arrow { width: 46rpx; height: 46rpx; flex: 0 0 46rpx; border-radius: 50%; color: #FFFFFF; background: #FF6A2A; box-shadow: 0 6rpx 13rpx rgba(255, 106, 42, 0.2); line-height: 46rpx; text-align: center; }
.detail-arrow .iconfont { font-size: 22rpx; }

.state-block { min-height: 430rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; color: #9D9187; font-size: 24rpx; }
.state-loader { width: 42rpx; height: 42rpx; margin-bottom: 18rpx; border: 4rpx solid #F4D5C5; border-top-color: #FF6A2A; border-radius: 50%; animation: category-spin 800ms linear infinite; }
.empty-symbol { width: 92rpx; height: 92rpx; margin-bottom: 18rpx; border-radius: 28rpx; color: #B4895D; background: #F5E9DB; font-size: 34rpx; font-weight: 800; line-height: 92rpx; text-align: center; }
.empty-title { color: #64584E; font-size: 27rpx; font-weight: 700; }
.empty-subtitle { margin-top: 8rpx; color: #A79C92; font-size: 22rpx; }
.page-spacer { height: 160rpx; }

.category-tabbar { position: fixed; z-index: 100; right: 18rpx; bottom: calc(14rpx + env(safe-area-inset-bottom)); left: 18rpx; height: 108rpx; padding: 8rpx 16rpx 6rpx; box-sizing: border-box; display: flex; align-items: center; justify-content: space-around; border: 1rpx solid rgba(234, 225, 216, 0.9); border-radius: 28rpx; background: rgba(255, 255, 255, 0.97); box-shadow: 0 12rpx 34rpx rgba(78, 55, 34, 0.13); }
.tab-item { position: relative; width: 25%; height: 92rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; color: #8E857D; transition: opacity 140ms ease, transform 140ms ease; }
.tab-icon { width: 48rpx; height: 48rpx; display: flex; align-items: center; justify-content: center; border-radius: 17rpx; }
.tab-icon .iconfont { font-size: 34rpx; }
.tab-text { margin-top: 1rpx; font-size: 20rpx; line-height: 28rpx; }
.tab-item.active { color: #F15D2B; }
.tab-item.active .tab-icon { color: #FFFFFF; background: linear-gradient(135deg, #FF8750, #FF5F2B); box-shadow: 0 7rpx 14rpx rgba(255, 106, 42, 0.2); }
.tab-item.active .tab-text { font-weight: 700; }
.tab-active-dot { position: absolute; bottom: 0; width: 18rpx; height: 5rpx; border-radius: 3rpx; background: #FF6A2A; }
.tab-pressed { opacity: 0.72; transform: translateY(2rpx); }

@keyframes category-spin { to { transform: rotate(360deg); } }
